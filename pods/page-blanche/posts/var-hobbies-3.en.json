  "4": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "write [[by hand]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "a journal, a letter, your notes: [[pen, not keyboard]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "a 2024 study: brains were [[far more connected]] writing by hand than typing"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "it's slower, and that's the point: you have to [[pick your words]] before they hit the page"
    }
   },
