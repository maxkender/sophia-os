  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "10/10 χόμπι που κάνουν τον εγκέφαλό σου πιο δυνατό"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(το λέει η επιστήμη)",
     "alignement": "droite"
    }
   },
   "images": {
