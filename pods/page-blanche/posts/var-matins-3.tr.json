     "en": [
      "not reading books"
     ],
     "texte": "[[ex'ini stalkla]]"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "daha yorganın altında onun 14 hikâyesini, sonra yeni arkadaşlarınınkini, sonra [[yemek yedikleri restoranı]] izliyorsun"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "7.30'da moralin çoktan bozuk ve [[asla gitmeyeceğin bir restoranın menüsünü]] ezbere biliyorsun"
    },
