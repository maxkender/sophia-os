  "2": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "išmok groti [[instrumentu]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "skaityti natas, judinti abi rankas ir klausytis vienu metu yra [[treniruotė visoms smegenims]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "muzikantų abi smegenų pusės yra [[geriau sujungtos]]"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "talento nereikia, 15 minučių praktikos per dieną jau [[treniruoja tavo smegenis]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_51db9d8e.jpg",
      "boite": [
       0,
       0,
       832,
       1248
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "stop announcing your plans"
     ],
     "texte": "išmok [[šokio choreografiją]]"
    },
    "T2": {
     "en": [
      "telling everyone your goals can give you a hit of",
      "dopamine before you've actually done anything"
     ],
     "texte": "įsimeni žingsnių seką, laikaisi ritmo ir taisai klaidas [[judesio metu]]"
    },
    "T3": {
     "en": [
      "you get to feel",
      "ambitious, receive",
      "praise, and imagine",
      "the end result",
      "without putting in",
      "the work"
     ],
     "texte": "21 metus trukęs tyrimas susiejo reguliarų šokį su [[mažesne demencijos rizika]]"
    },
    "T4": {
     "en": [
      "stop talking about what you're going to do. disappear,",
      "put your head down, and let your results speak for you"
     ],
     "texte": "atmintis, koordinacija ir dėmesys vienu metu, ir tikrai [[smagiausias būdas]] juos lavinti"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_f36edfe3.jpg",
      "boite": [
       0,
