    "2": {
      "textes": {
        "T1": {
          "en": [
            "spend more time without stimulation"
          ],
          "fr": "passe plus de temps [[à ne rien faire]]"
        },
        "T2": {
          "en": [
            "stop filling every walk,",
            "meal, and spare minute",
            "with content and music"
          ],
          "fr": "lâche [[les vidéos]] et [[la musique]] pendant tes balades, tes repas, [[tes temps morts]]"
        },
        "T3": {
          "en": [
            "quiet gives your brain",
            "room to replay",
            "information, connect",
            "ideas, and form its own",
            "thoughts"
          ],
          "fr": "dans le calme, ton cerveau digère ce qu'il a vu, fait des liens et [[se fait ses propres idées]]"
        },
        "T4": {
          "en": [
            "constant short-form content is making your brain rot",
            "and ruining your attention span!!"
          ],
          "fr": "les vidéos courtes non-stop te [[grillent le cerveau]] et [[flinguent ta concentration!!]]"
        }
      },
      "images": {
        "I1": "garder"
      }
    },
    "3": {
      "textes": {
        "T1": {
          "en": [
            "stop outsourcing every",
            "thought"
          ],
          "fr": "recommence à [[penser par toi-même]]"
        },
        "T2": {
          "en": [
            "don’t ask google or AI the second you get stuck"
          ],
          "fr": "ne cours pas sur google ou [[l'IA dès que tu bloques]]"
        },
        "T3": {
          "en": [
            "sit with the problem",
            "first, make a guess,",
            "then check yourself"
          ],
          "fr": "[[cherche d'abord toute seule]], tente une réponse, puis vérifie"
        },
        "T4": {
          "en": [
            "struggling for the",
            "answer is part of what",
            "makes the learning",
            "stick"
          ],
          "fr": "[[galérer]] à trouver, c'est justement ce qui fait que [[ça rentre]]"
        },
        "T5": {
          "en": [
            "don't offload your",
            "understanding and",
            "thought process, it's",
            "what keeps you alive"
          ],
          "fr": "laisse personne [[comprendre]] à ta place : c'est ça qui [[garde ton esprit vif]]"
        }
      },
      "images": {
        "I1": "garder",
        "I2": "garder",
        "I3": "garder"
      }
    },
    "4": {
      "textes": {
        "T1": {
          "en": [
            "start reading everyday"
          ],
          "fr": "apprends un truc [[chaque jour]]"
        },
        "T2": {
          "en": [
            "scrolling feeds you",
            "constant dopamine and",
            "burns your dopamine",
            "receptors"
          ],
          "fr": "le scroll t'envoie [[de la dopamine non-stop]] et [[crame tes récepteurs]]"
        },
        "T3": {
          "en": [
            "i use readup to block my",
            "apps for 20 minutes until i",
            "read"
          ],
          "fr": "perso j'ai remplacé mon scroll par [[5 min sur l'appli Sophia]]",
          "texte": "perso, j'ai remplacé une partie de mon scroll par [[5 min par jour sur l'appli Sophia]]"
        },
        "T4": {
          "en": [
            "reading forces you to hold",
            "attention, remember",
            "details, and follow one",
            "idea for longer"
          ],
          "fr": "apprendre, ça t'oblige à [[te concentrer]], [[retenir des détails]] et suivre une idée jusqu'au bout"
        },
        "T5": {
          "en": [
            "even a little every day is",
            "enough to start rebuilding",
            "your attention span"
          ],
          "fr": "même un petit peu par jour suffit à [[réparer ta concentration]]"
        }
      },
      "images": {
        "I1": "sophia_capture"
      }
    },
    "5": {
      "textes": {
        "T1": {
          "en": [
            "challenge your own biases"
          ],
          "fr": "méfie-toi de [[tes propres biais]]"
        },
        "T2": {
          "en": [
            "your brain loves evidence that proves what you",
            "already believe"
          ],
          "fr": "ton cerveau adore tout ce qui confirme [[ce que tu penses déjà]]"
        },
        "T3": {
          "en": [
            "actively look for the",
            "strongest argument",
            "against your opinion"
          ],
          "fr": "va chercher exprès [[le meilleur argument contre]] ton avis"
        },
        "T4": {
          "en": [
            "getting smarter",
            "means getting better",
            "at noticing when your",
            "own thinking is wrong"
          ],
          "fr": "être plus intelligente, c'est surtout mieux voir [[quand ton raisonnement est faux]]"
        }
      },
      "images": {
        "I1": "garder"
      }
    },
    "6": {
      "textes": {
        "T1": {
          "en": [
            "explain what you learn out loud"
          ],
          "fr": "dis [[à voix haute]] ce que t'as appris"
        },
        "T2": {
          "en": [
            "close the book, article, or",
            "video and explain the idea",
            "from memory"
          ],
          "fr": "ferme le livre, l'article ou la vidéo et réexplique l'idée [[de tête]]"
        },
        "T3": {
          "en": [
            "the moment you get vague",
            "or confused, you’ve found",
            "the gap"
          ],
          "fr": "dès que tu t'embrouilles, t'as trouvé ce que t'as pas compris"
        },
        "T4": {
          "en": [
            "teaching exposes weak",
            "understanding faster than",
            "rereading does"
          ],
          "fr": "[[expliquer fait ressortir tes lacunes]] plus vite que relire"
        }
      },
      "images": {
