  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "odgodi alarm [[6 puta zaredom]]"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "svakih 9 minuta opet zaspiš, a alarm te ponovno iščupa iz sna. baš odmarajuće"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "nakon sat vremena napokon ustaneš, [[a umor je veći nego kod prvog alarma]], i imaš još 12 minuta"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "četkica za zube u jednoj ruci, tenisica u drugoj, i trkom kroz vrata. [[potpuni mir]]"
    }
   },
   "images": {
