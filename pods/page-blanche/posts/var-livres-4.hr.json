     "en": [
      "get good at writing"
     ],
     "texte": "5. [[Siddhartha]], Hesse"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "oko 150 stranica, napisana 1922."
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "mladić napusti dom da pronađe smisao života, okuša bogatstvo i ljubav, i [[pronađe ga uz rijeku]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
