  "3": {
   "textes": {
    "T1": {
     "en": [
      "play and study chess"
     ],
     "texte": "2. [[Silk]], Baricco"
    },
    "T2": {
     "en": [
      "chess forces you to calculate ahead, recognise",
      "patterns, and constantly ask “what am I missing?”"
     ],
     "texte": "in the 1860s, a French silkworm trader travels all the way to Japan, and one look changes his life"
    },
    "T3": {
     "en": [
      "don't just play random",
      "games, analyse them",
      "afterwards"
     ],
     "texte": "the chapters are tiny, some [[barely a page long]]"
    },
    "T4": {
     "en": [
      "science proves that",
      "even 20–30 minutes a",
      "day gives your brain",
      "deliberate problem-",
      "solving practice"
     ],
     "texte": "it reads like a song, quiet and strange, and you'll [[finish it in one evening]] without noticing"
    }
   },
   "images": {
