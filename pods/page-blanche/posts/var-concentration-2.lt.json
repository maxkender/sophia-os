  "2": {
   "textes": {
    "T1": {
     "en": [
      "they make decisions fast"
     ],
     "texte": "mokytis [[iš lovos]]"
    },
    "T2": {
     "en": [
      "successful people don’t procrastinate. they don’t",
      "ask for permission, but instead act and ask for",
      "forgiveness"
     ],
     "texte": "kompiuteris ant kelių, antklodė, pagalvė už nugaros. jauku, bet tavo smegenims [[lova = poilsis]]"
    },
    "T3": {
     "en": [
      "they don’t spend 3",
      "weeks thinking",
      "about a reversible",
      "choice"
     ],
     "texte": "tad vos tik įsitaisai, [[dėmesys ištirpsta]]"
    },
    "T4": {
     "en": [
      "if the downside is small, they decide, act, and",
      "adjust. speed matters most when decisions can",
      "be changed later"
     ],
     "texte": "ir tai veikia abiem kryptimis: kuo daugiau ten dirbi, [[tuo prasčiau miegi]]. lova skirta miegui"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
