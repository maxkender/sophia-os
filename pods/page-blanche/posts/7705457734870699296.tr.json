  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "[[kaydırmak yerine]] kitap oku"
    },
    "T2": {
     "en": [
      "bill gates reads around 50 books a year"
     ],
     "texte": "bill gates yılda yaklaşık [[50 kitap okuyor]]"
    },
    "T3": {
     "en": [
      "doomscrolling is rotting your",
      "brain"
     ],
     "texte": "doomscrolling [[beynini çürütüyor]]"
    },
    "T4": {
     "en": [
      "books do the opposite, they",
      "make you focus and think for",
      "yourself"
     ],
     "texte": "kitaplar tam tersini yapar, [[odaklanırsın]] ve [[kendi kafanla düşünürsün]]"
    },
    "T5": {
     "en": [
      "i used to doomscroll all day",
      "but now use this thing that",
      "blocks my apps until i read",
      "for 20 minutes"
     ],
     "texte": "zaten telefondaysam [[Sophia uygulamasında]] 5 dakika ders yapıyorum. bugün: [[rönesans neden İtalya'da başladı]]"
    }
