  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "alarmı [[üst üste 6 kere]] ertele"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "9 dakikada bir uykuya dalıyorsun, alarm seni yine söküp alıyor. çok dinlendirici"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "bir saat sonra nihayet kalkıyorsun, [[ilk alarmdakinden daha yorgun]], ve sadece 12 dakikan kalmış"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "bir elde diş fırçası, diğerinde ayakkabı, koşarak kapıdan çıkıyorsun. [[tam bir huzur]]"
    }
   },
   "images": {
