  "5": {
   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "nincs reggeli, [[csak kávé]]"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "két presszókávé üres gyomorra, és aztán semmi más délig"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "10-re kicsit remeg a kezed, és a koncentrációd [[elszállt]]"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "11:40-kor megeszel egy egész csomag kekszet a billentyűzet fölött. [[kiegyensúlyozott!!]]"
    }
   },
