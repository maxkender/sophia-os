   }
  },
  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "fejts [[keresztrejtvényt]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "az egyik meghatározásnál végigpörgetsz minden szót, amit ismersz, a másik csak akkor jön meg, [[ha a többit már kitöltötted]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "szókincs, memória és logika egyben"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "és a vasárnapi kávédnak [[végre van célja]]"
    }
   },
