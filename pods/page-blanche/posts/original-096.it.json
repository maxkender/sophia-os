  "2": {
   "textes": {
    "T1": {
     "en": [
      "stop binge-watching video essays"
     ],
     "fr": "basta maratone di [[video essay]]",
     "texte": "legalo al [[caffè del mattino]]"
    },
    "T2": {
     "en": [
      "a 2 hour video about history or psychology makes",
      "you feel like you're learning so much"
     ],
     "fr": "un video di 2 ore su storia o psicologia ti fa sentire come se [[stessi imparando tantissimo]]",
     "texte": "non aspettare il tempo libero, scegli un momento che c'è già [[tutti i giorni]]"
    },
    "T3": {
     "en": [
      "but you're just",
      "passively watching",
      "someone else think,"
     ],
     "fr": "ma guardi solo [[passivamente]] un altro che pensa,",
     "texte": "stessa tazza, stessa sedia, [[stesso piccolo rito]],"
    },
    "T4": {
     "en": [
      "and your brain",
      "never has to do the",
      "work"
     ],
     "fr": "e [[il tuo cervello]] non [[fa mai la fatica]]",
     "texte": "e il cervello inizia ad associare [[il caffè a qualcosa di nuovo]]"
    },
    "T6": {
     "en": [
      "just watching a video essay does not mean you learnt",
      "anything, you just wasted 2 hours"
     ],
     "fr": "guardare un video essay [[non vuol dire che hai imparato qualcosa]], [[hai solo perso 2 ore]]",
     "texte": "dopo qualche settimana è il caffè stesso a [[ricordarti di imparare qualcosa]]"
    },
    "T5": {
     "en": [
      ""
     ],
     "fr": "",
     "texte": "",
     "garder": true
    }
   },
