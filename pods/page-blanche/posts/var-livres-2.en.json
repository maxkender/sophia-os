  "4": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "3. [[Animal Farm]] by Orwell"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "the animals kick out the farmer to be free and equal, then the pigs take over, and [[the rules start changing at night]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "about 100 pages, [[one night]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "and on nights i grab my phone anyway, i do a 5 min lesson on [[the Sophia app]] instead of reels"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "tonight: why the renaissance began in italy. i told my mom everything"
    }
