  "6": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "fr": "scroller [[dès que tu t'ennuies]]",
     "texte": "5. [[Dr. Jekyll ve Mr. Hyde]]"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "fr": "tu perds facile [[2–3 h par jour sans t'en rendre compte]], puis tu te demandes pourquoi t'as [[jamais le temps]] pour [[ce qui compte]]",
     "texte": "Stevenson'dan. saygın bir doktor, şiddet dolu bir yabancı ve hiç mantıklı olmayan bir vasiyet. [[polisiye gibi okunuyor]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "fr": "[[reprends la main]] sur ton temps.",
     "texte": "scroll'un yerine geçenler:"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "fr": "perso j'ai remplacé mon scroll du soir par [[5 min sur l'appli Sophia]], du coup je scrolle plus dans le vide",
     "texte": "komodinin üstünde kısa bir kitap, yürürken podcast ve telefonu yine de elime aldığımda [[Sophia uygulaması]]"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "fr": "ton tel peut bien attendre que t'aies fait [[un truc que t'avais prévu]].",
     "texte": "bugünkü 5 dakikalık ders: Rönesans neden İtalya'da başladı"
    }
   },
