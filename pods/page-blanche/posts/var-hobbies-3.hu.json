  "4": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "írj [[kézzel]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "napló, levél, jegyzetek: [[toll, nem billentyűzet]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "egy 2024-es kutatás szerint kézírásnál az agy [[sokkal összekapcsoltabb]], mint gépelésnél"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "lassabb, és pont ez a lényeg: [[meg kell válogatnod a szavaid]], mielőtt papírra kerülnek"
    }
   },
