  "4": {
   "textes": {
    "T1": {
     "en": [
      "learn from history's greatest minds"
     ],
     "fr": "inspire-toi [[des plus grands esprits]]",
     "texte": "tanulj kevesebbet, de [[minden nap]]"
    },
    "T2": {
     "en": [
      "read philosophy, history,",
      "biographies and literature",
      "from people who spent",
      "decades thinking deeply"
     ],
     "fr": "lis de la philo, de l'histoire, des biographies et des romans de gens qui ont [[passé leur vie à réfléchir]]",
     "texte": "rövid alkalmak több napon át jobban megmaradnak, mint egy nagy magolás. ez az [[elosztott tanulás]]"
    },
    "T3": {
     "en": [
      "if you can't focus",
      "because you get bored",
      "and start scrolling, use",
      "readup to block your",
      "apps until you've read for",
      "20 minutes"
     ],
     "fr": "si tu t'ennuies vite et que tu finis sur tiktok, commence par [[5 minutes par jour sur l'appli Sophia]]",
     "texte": "régen csak görgettem, most a telefonon minden nap tanulok egy kicsit, ma azt, miért Olaszországban indult a reneszánsz, [[a Sophia appban]]"
    }
   },
   "images": {
    "I1": "sophia_capture",
    "I2": "sophia_appstore"
   }
  },
  "5": {
   "textes": {
    "T1": {
     "en": [
      "dont go on your phone first thing in the",
      "morning"
     ],
     "fr": "touche pas à ton tel [[dès le réveil]]",
     "texte": "[[írd le minden aggodalmadat]] közvetlenül a vizsga előtt"
    },
    "T2": {
     "en": [
      "messages, news, tiktok, you're reacting to",
      "everyone else before you've even got out of bed"
     ],
     "fr": "messages, actus, tiktok, tu réagis [[à tout le monde]] avant même de sortir du lit",
     "texte": "a legrosszabb ötletnek tűnik közvetlenül egy dolgozat előtt, de [[kitisztítja a fejed]]"
    },
    "T3": {
     "en": [
      "your brain gets a hit of",
      "dopamine before you've",
      "done anything"
     ],
     "fr": "ton cerveau prend [[un shot de dopamine]] avant que t'aies rien fait",
     "texte": "az aggódás elveszi a helyet a [[tiszta gondolkodás]] elől"
    },
    "T4": {
     "en": [
      "and the rest of your",
      "day feels boring. give",
      "yourself the first 30",
      "minutes without your",
      "phone"
     ],
     "fr": "et le reste de ta journée [[paraît fade]]. offre-toi 30 minutes sans ton tel au réveil",
     "texte": "egy kutatásban a stresszes diákok, akik a teszt előtt leírták a félelmeiket, [[jobban teljesítettek]]"
    }
   },
