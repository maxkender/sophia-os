  "3": {
   "textes": {
    "T1": {
     "en": [
      "play and study chess"
     ],
     "texte": "2. [[Seda]], Baricco"
    },
    "T2": {
     "en": [
      "chess forces you to calculate ahead, recognise",
      "patterns, and constantly ask “what am I missing?”"
     ],
     "texte": "en la década de 1860, un comerciante francés de gusanos de seda viaja hasta Japón, y una mirada le cambia la vida"
    },
    "T3": {
     "en": [
      "don't just play random",
      "games, analyse them",
      "afterwards"
     ],
     "texte": "los capítulos son mínimos, algunos [[de apenas una página]]"
    },
    "T4": {
     "en": [
      "science proves that",
      "even 20–30 minutes a",
      "day gives your brain",
      "deliberate problem-",
      "solving practice"
     ],
     "texte": "se lee como una canción, tranquila y extraña, y [[lo terminas en una noche]] sin darte cuenta"
    }
   },
   "images": {
