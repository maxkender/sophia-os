  "4": {
   "textes": {
    "T1": {
     "en": [
      "doomscrolling everyday"
     ],
     "fr": "doomscroller [[tous les jours]]",
     "texte": "scrollear [[todos los días]]"
    },
    "T2": {
     "en": [
      "you watch hundreds of videos",
      "a day and can't remember a",
      "single one by dinner. that is",
      "frying your memory"
     ],
     "fr": "tu regardes des centaines de vidéos par jour et le soir [[t'en as plus une seule en tête]]. ça grille ta mémoire",
     "texte": "ves cientos de videos al día y en la cena [[no recuerdas ni uno]]. eso te está friendo la memoria"
    },
    "T3": {
     "en": [
      "you can try using willpower",
      "to stop, but i use a thing",
      "that blocks tiktok until i read",
      "a book for 20 minutes"
     ],
     "fr": "ce qui a remplacé mon scroll, c'est un livre le soir, des balades sans musique et [[l'appli Sophia]], hier sur Camus",
     "texte": "lo que reemplazó mi scroll: un libro por la noche, paseos sin cascos y [[la app Sophia]], hoy: por qué el cielo es azul"
    },
    "T4": {
     "en": [
      "don't become illiterate!!"
     ],
     "fr": "[[protège ta mémoire !!]]",
     "texte": "[[¡¡cuida tu memoria!!]]"
    },
