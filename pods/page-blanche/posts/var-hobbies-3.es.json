  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "camina [[rápido y al aire libre]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "40 minutos, 3 veces por semana, en un sitio verde. sin podcast: deja que tu mente [[divague y lo ordene todo]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "en mayores, un año caminando rápido [[agrandó el hipocampo]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "y tus mejores ideas llegan [[a mitad de camino]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_9bd8c2eb.jpg",
