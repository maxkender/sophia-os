  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "fr": "leggi libri [[invece di scrollare]]",
     "texte": "impara col telefono, [[per una volta]]"
    },
    "T2": {
     "en": [
      "every hour you spend scrolling is an hour you could",
      "spend developing your mind"
     ],
     "fr": "ogni ora di scroll è un'ora che potresti usare per [[allenare la mente]]",
     "texte": "tanto prendi il telefono tutto il giorno, quindi fai [[contare almeno uno di quei momenti]]"
    },
    "T3": {
     "en": [
      "read 10 pages a day, even",
      "when you don't feel like it"
     ],
     "fr": "[[leggi 10 pagine al giorno]], anche quando non ti va",
     "texte": "[[una lezione breve al giorno]]: storia, arte, scienza"
    },
    "T4": {
     "en": [
      "you say you want to read",
      "more, but get caught in the",
      "algorithm every time"
     ],
     "fr": "dici che [[vuoi leggere di più]], ma ogni volta [[l'algoritmo]] ti risucchia",
     "texte": "si infila proprio nel buco in cui [[scrolleresti a vuoto]]"
    },
    "T5": {
     "en": [
      "i used to doomscroll all day",
      "but now use this thing that",
      "blocks my apps until i read",
      "for 20 minutes"
     ],
     "fr": "prima scrollavo e basta, ora se sono al telefono [[imparo qualcosa in 5 min con l'app Sophia]]",
     "texte": "prima scrollavo all'infinito, ora quando sono comunque sul telefono faccio [[5 minuti di lezione sull'app Sophia]]"
    }
   },
