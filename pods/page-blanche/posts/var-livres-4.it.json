    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickens. un vecchio avaro riceve la visita di tre fantasmi in una sola notte"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "passato, presente e futuro, e la mattina dopo [[non è più lo stesso uomo]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "circa 100 pagine, [[perfetto per dicembre]]"
