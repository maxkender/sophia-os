  "3": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "2. [[Az alkimista]], Coelho"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "egy fiatal pásztor kincsről álmodik a piramisoknál, eladja a juhait és útnak indul, és [[az út többet tanít neki az aranynál]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "200 oldal alatt, [[egy hétvége]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "ami kiváltotta a görgetést: egy könyv a táskámban, zene séta közben és [[a Sophia app]], ha mégis előveszem a telefont"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "a mai 5 perces lecke ott: miért Olaszországban született a reneszánsz"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[A gyöngy]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeck. egy szegény búvár rátalál a legnagyobb gyöngyre"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "az orvos, a kereskedők, az egész város akarja, és az álma [[lassan rémálommá válik]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "100 oldal alatt, régi meseként megírva, egyetlen este alatt kiolvasod"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[de az a vége, komolyan]]"
    }
   },
