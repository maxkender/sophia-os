  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "deja [[las cortinas cerradas]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "ni un rayo de sol, solo la luz del móvil. tu cerebro cree que son las 3 de la mañana"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "así que sigue en modo reposo y tú vagas por la cocina como [[un zombi perdido]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "la luz es [[para la gente mañanera]]"
    }
   },
   "images": {
    "I1": {
