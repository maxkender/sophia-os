  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "gamink [[be recepto]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "atidaryk šaldytuvą, pažiūrėk, kas yra, ir sugalvok patiekalą. laikas, ragavimas, taisymas: [[smegenys valdo viską]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "planavimas ir kūryba viename"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "o vakarienė yra [[tavo atlygis]]"
    }
   },
