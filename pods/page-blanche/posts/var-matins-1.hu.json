  "4": {
   "textes": {
    "T1": {
     "en": [
      "not reading books"
     ],
     "texte": "[[görgess]] az ágyban"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "egyik szemed nyitva, a másik még alszik: 40 perc mások élete, stresszes hírek és [[47 értesítés]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "még senkihez nem szóltál egy szót sem, és az agyad [[máris túlterhelt]]. remek bemelegítés"
    },
    "T4": {
     "en": [
      "i struggled with stopping",
      "scrolling until i found this",
      "thing that blocks my apps",
      "until i read for 20 minutes"
     ],
     "texte": "és soha ne cseréld le ezt a görgetést egy könyvre, egy podcastra vagy egy 5 perces leckére [[a Sophia appban]]"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
