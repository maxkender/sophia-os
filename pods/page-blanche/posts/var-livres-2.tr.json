  "3": {
   "textes": {
    "T1": {
     "en": [
      "play and study chess"
     ],
     "texte": "2. [[İpek]], Baricco"
    },
    "T2": {
     "en": [
      "chess forces you to calculate ahead, recognise",
      "patterns, and constantly ask “what am I missing?”"
     ],
     "texte": "1860'larda Fransız bir ipekböceği tüccarı ta Japonya'ya gidiyor ve tek bir bakış hayatını değiştiriyor"
    },
    "T3": {
     "en": [
      "don't just play random",
      "games, analyse them",
      "afterwards"
     ],
     "texte": "bölümler minicik, bazıları [[bir sayfa bile değil]]"
    },
    "T4": {
     "en": [
      "science proves that",
      "even 20–30 minutes a",
      "day gives your brain",
      "deliberate problem-",
      "solving practice"
     ],
     "texte": "bir şarkı gibi okunuyor, sakin ve tuhaf, ve fark etmeden [[bir akşamda bitiriyorsun]]"
    }
   },
   "images": {
