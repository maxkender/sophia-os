  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "10/10 hobbies que deixam seu cérebro mais forte"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(a ciência confirma)",
     "alignement": "droite"
    }
   },
   "images": {
