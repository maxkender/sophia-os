  "1": {
   "textes": {
    "T1": {
     "en": [
      "5 things i did that fixed my",
      "phone addiction"
     ],
     "texte": "5 книги, които се четат точно като [[сериал]]"
    },
    "T2": {
     "en": [
      "(from 14 hours",
      "screen time to 3)"
     ],
     "texte": "(просто не можеш да ги оставиш)"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
