   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "1. [[El viejo y el mar]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "un viejo pescador, 84 días sin pescar nada, y luego [[un pez gigante]] que no se rinde"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "es una larga pelea en el mar, y [[estás de su lado]] hasta la última página"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "Hemingway, 120 páginas, [[un domingo tranquilo]]"
    }
   },
   "images": {
    "I1": {
