  "6": {
   "textes": {
    "T1": {
     "en": [
      "journal every night"
     ],
     "fr": "un diario [[ogni sera]]",
     "texte": "racconta [[cosa hai imparato]]"
    },
    "T2": {
     "en": [
      "your thoughts feel messy and unclear until you try to",
      "write them down"
     ],
     "fr": "i pensieri sembrano [[confusi e disordinati]] finché non [[li scrivi]]",
     "texte": "spiegare qualcosa ad alta voce ti mostra [[cosa hai capito davvero]]"
    },
    "T3": {
     "en": [
      "even 5 minutes before",
      "bed is proven to help",
      "you think more clearly"
     ],
     "fr": "5 minuti prima di dormire ti schiariscono [[le idee]], è [[provato]]",
     "texte": "una curiosità a cena, un vocale [[a chi ti conosce meglio]]"
    },
    "T4": {
     "en": [
      "and you start noticing",
      "patterns in your own life",
      "you'd never see otherwise"
     ],
     "fr": "e inizi a notare [[schemi nella tua vita]] che non vedresti mai",
     "texte": "e quando ti chiedono [[cosa hai imparato oggi]], vorrai avere una risposta"
    }
   },
