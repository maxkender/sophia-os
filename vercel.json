{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/api/qg/:path*",
      "destination": "https://mbikecieskoobeizixig.supabase.co/functions/v1/qg/:path*"
    },
    {
      "source": "/api/whatsapp/:path*",
      "destination": "https://mbikecieskoobeizixig.supabase.co/functions/v1/whatsapp/:path*"
    },
    {
      "source": "/((?!assets/|api/qg/|api/whatsapp/).*)",
      "destination": "/index.html"
    }
  ]
}
