  "4": {
   "textes": {
    "T1": {
     "en": [
      "not reading books"
     ],
     "texte": "[[skroluj]] u krevetu"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "jedno oko otvoreno, drugo još spava: 40 minuta tuđih života, vesti koje stresiraju i [[47 notifikacija]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "još ni sa kim ne progovaraš ni reč, a mozak ti je [[već preopterećen]]. odlično zagrevanje"
    },
    "T4": {
     "en": [
      "i struggled with stopping",
      "scrolling until i found this",
      "thing that blocks my apps",
      "until i read for 20 minutes"
     ],
     "texte": "i nikad ne menjaj taj skrol za knjigu, podkast ili lekciju od 5 minuta dnevno [[u aplikaciji Sophia]]"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "5": {
   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "bez doručka, [[samo kafa]]"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "dva espresa na prazan stomak i ništa drugo do podneva"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "u 10 ti se ruke malo tresu, a koncentracija je [[otišla]]"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "u 11:40 pojedeš celo pakovanje keksa iznad tastature. [[izbalansirano!!]]"
    }
   },
