  "4": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "3. [[Rebelión en la granja]], Orwell"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "los animales echan al granjero para ser libres e iguales, luego los cerdos toman el poder y [[las reglas cambian de noche]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "unas 100 páginas, [[una noche]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "y las noches que agarro el teléfono igual, hago una lección de 5 min en [[la app Sophia]] en vez de ver reels"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "esta noche: por qué el cielo es azul. se lo conté todo a mi mamá"
    }
   },
