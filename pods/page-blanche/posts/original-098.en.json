  "6": {
   "textes": {
    "T1": {
     "en": [
      "wake up before everyone else"
     ],
     "texte": "[[allow 3 seconds]] of silence"
    },
    "T2": {
     "en": [
      "no messages, no notifications, no one needs you yet"
     ],
     "texte": "don't rush to fill every pause with [[\"so yeah...\"]]"
    },
    "T3": {
     "en": [
      "the first hour of the day is",
      "when your focus is at its",
      "best, so use it for your",
      "own goals"
     ],
     "texte": "most of the time, they [[pick it back up]] with what they really wanted to say"
    },
    "T4": {
     "en": [
      "before anyone else can",
      "take your attention"
     ],
     "texte": "a pause [[isn't a fail]]"
    },
    "T5": {
     "en": [
      "even 30 minutes earlier makes a difference"
     ],
     "texte": "the best talks often start [[right after a silence]]"
    }
   },
