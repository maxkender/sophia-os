  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "sétálj [[gyorsan, a szabadban]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "40 perc, hetente háromszor, valahol a zöldben. podcast nélkül: hagyd, hogy a gondolataid [[elkalandozzanak és rendeződjenek]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "időseknél egy év tempós séta [[megnövelte a hippokampuszt]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "és a legjobb ötletek [[séta közben]] jönnek"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_9bd8c2eb.jpg",
      "boite": [
       0,
