   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[Die Perle]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeck. ein armer Taucher findet die größte Perle aller Zeiten"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "der Arzt, die Händler, die ganze Stadt wollen sie, und sein Traum [[wird langsam zum Albtraum]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "unter 100 Seiten, geschrieben wie eine alte Fabel, an einem Abend durch"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[und dieses Ende erst]]"
    }
   },
