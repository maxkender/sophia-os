  "4": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "[[hava durumuna]] 5 kez bak"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "yatakta, lavaboda, kahvenin başında, merdivende: « %90 yağmur ». tamamdır"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "sonra yine de [[şemsiyesiz]] çıkıyorsun, çünkü içinden bir ses birazdan dinecek diyor"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "8.10'da [[sırılsıklam çoraplar]]"
    }
   },
