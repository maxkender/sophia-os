  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "fr": "10/10 hobbies pour te faire un cerveau en béton",
     "texte": "come imparare qualcosa ogni giorno, davvero"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "fr": "(la science est d'accord)",
     "texte": "(anche se odiavi la scuola)",
     "alignement": "droite"
    }
   },
