  "2": {
   "textes": {
    "T1": {
     "en": [
      "stop announcing your plans"
     ],
     "texte": "tanulj meg [[fotózni]]"
    },
    "T2": {
     "en": [
      "telling everyone your goals can give you a hit of",
      "dopamine before you've actually done anything"
     ],
     "texte": "fény, kompozíció, időzítés: minden kép megtanít [[észrevenni, amit mások nem]]"
    },
    "T3": {
     "en": [
      "you get to feel",
      "ambitious, receive",
      "praise, and imagine",
      "the end result",
      "without putting in",
      "the work"
     ],
     "texte": "egy kutatásban a 3 hónapig fotózni tanuló idősek memóriája [[jobban javult]], mint a csak társasági programokra járóké"
    },
    "T4": {
     "en": [
      "stop talking about what you're going to do. disappear,",
      "put your head down, and let your results speak for you"
     ],
     "texte": "nem kell drága felszerelés, a telefonod is elég az induláshoz, a lényeg, hogy [[megtanulj nézni]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_0a28ab50.jpg",
      "boite": [
       0,
       0,
       2368,
       1760
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "tanulj [[egy új nyelvet]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "új szavak, új nyelvtan: az agyad egész nap [[két rendszer között vált]]"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "kétnyelvűeknél a demencia tünetei átlagosan [[kb. 4 évvel később]] jelentkeznek"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "ma végre megértettem, miért Itáliában indult a reneszánsz, 5 perc alatt [[a Sophia appban]]"
    }
   },
