  "2": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "aprenda [[um instrumento]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "ler partitura, mexer as duas mãos e ouvir ao mesmo tempo é [[academia pro cérebro]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "nos músicos, os dois lados do cérebro são [[mais conectados]]"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "não precisa de talento, 15 minutos de prática por dia já [[treinam seu cérebro]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_51db9d8e.jpg",
      "boite": [
       0,
       0,
       832,
       1248
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "stop announcing your plans"
     ],
     "texte": "aprenda [[uma coreografia]]"
    },
    "T2": {
     "en": [
      "telling everyone your goals can give you a hit of",
      "dopamine before you've actually done anything"
     ],
     "texte": "você decora uma sequência, segue o ritmo e se corrige [[em pleno movimento]]"
    },
    "T3": {
     "en": [
      "you get to feel",
      "ambitious, receive",
      "praise, and imagine",
      "the end result",
      "without putting in",
      "the work"
     ],
     "texte": "um estudo de 21 anos ligou dançar com frequência a [[menos risco de demência]]"
    },
    "T4": {
     "en": [
      "stop talking about what you're going to do. disappear,",
      "put your head down, and let your results speak for you"
     ],
     "texte": "memória, coordenação e foco de uma vez só, e sinceramente [[o jeito mais divertido]] de treinar"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_f36edfe3.jpg",
      "boite": [
       0,
       0,
       2208,
       1888
      ]
     }
    }
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "se localize [[sem GPS]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "siga o mapa na sua cabeça e repare nas ruas, nas lojas, [[nas curvas]]"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "os taxistas de londres têm [[uma área da memória maior]] no cérebro"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "antes eu vivia no scroll, agora quando pego o celular faço [[uma aula de 5 min no app Sophia]]"
    }
   },
