  "4": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "3. [[Hayvan Çiftliği]], Orwell"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "hayvanlar özgür ve eşit olmak için çiftçiyi kovuyor, sonra domuzlar yönetimi ele geçiriyor ve [[kurallar geceleri değişmeye başlıyor]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "yaklaşık 100 sayfa, [[tek gece]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "ve yine de telefonu elime aldığım akşamlar, reels yerine [[Sophia uygulamasında]] 5 dakikalık bir ders yapıyorum"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "bu akşam: Rönesans neden İtalya'da doğdu. hepsini anneme anlattım"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
