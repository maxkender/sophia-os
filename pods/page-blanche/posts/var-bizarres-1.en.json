  "4": {
   "textes": {
    "T1": {
     "en": [
      "learn from history's greatest minds"
     ],
     "fr": "inspire-toi [[des plus grands esprits]]",
     "texte": "study less, but [[every day]]"
    },
    "T2": {
     "en": [
      "read philosophy, history,",
      "biographies and literature",
      "from people who spent",
      "decades thinking deeply"
     ],
     "fr": "lis de la philo, de l'histoire, des biographies et des romans de gens qui ont [[passé leur vie à réfléchir]]",
     "texte": "short sessions spread over several days stick way better than one long cram. it's called the [[spacing effect]]"
    },
    "T3": {
     "en": [
      "if you can't focus",
      "because you get bored",
      "and start scrolling, use",
      "readup to block your",
      "apps until you've read for",
      "20 minutes"
     ],
     "fr": "si tu t'ennuies vite et que tu finis sur tiktok, commence par [[5 minutes par jour sur l'appli Sophia]]",
     "texte": "i used to doomscroll, now when i'm on my phone anyway i learn a bit every day, like why the renaissance started in italy, on [[the Sophia app]]"
    }
   },
   "images": {
    "I1": "sophia_capture",
    "I2": "sophia_appstore"
   }
  },
  "5": {
   "textes": {
    "T1": {
     "en": [
      "dont go on your phone first thing in the",
      "morning"
     ],
     "texte": "[[write down your worries]] before an exam"
    },
    "T2": {
     "en": [
      "messages, news, tiktok, you're reacting to",
      "everyone else before you've even got out of bed"
     ],
     "texte": "sounds like the worst idea right before a test, but it [[clears your head]]"
    },
    "T3": {
     "en": [
      "your brain gets a hit of",
      "dopamine before you've",
      "done anything"
     ],
     "texte": "worrying eats up the mental space you need to [[think clearly]]"
    },
    "T4": {
     "en": [
      "and the rest of your",
      "day feels boring. give",
      "yourself the first 30",
      "minutes without your",
      "phone"
     ],
     "texte": "in one study, stressed students who wrote about their fears for a few minutes before a test [[did better]]"
    }
   },
