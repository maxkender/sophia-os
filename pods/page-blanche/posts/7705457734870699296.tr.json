  "5": {
   "textes": {
    "T1": {
     "en": [
      "dont go on your phone first thing in the",
      "morning"
     ],
     "texte": "[[uyanır uyanmaz]] telefona bakma"
    },
    "T2": {
     "en": [
      "messages, news, tiktok, you're reacting to",
      "everyone else before you've even got out of bed"
     ],
     "texte": "mesajlar, haberler, tiktok, yataktan bile çıkmadan [[herkese tepki veriyorsun]]"
    },
    "T3": {
     "en": [
      "your brain gets a hit of",
      "dopamine before you've",
      "done anything"
     ],
     "texte": "daha hiçbir şey yapmadan beynin [[bir doz dopamin]] alıyor"
    },
    "T4": {
     "en": [
      "and the rest of your",
      "day feels boring. give",
      "yourself the first 30",
      "minutes without your",
      "phone"
     ],
     "texte": "ve günün geri kalanı [[sıkıcı geliyor]]. ilk 30 dakikayı telefonsuz geçir"
    }
   },
