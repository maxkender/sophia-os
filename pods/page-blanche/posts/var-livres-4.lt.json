   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "4. [[Kalėdų giesmė]] (1843)"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickensas. godų senį per vieną vienintelę naktį aplanko trys dvasios"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "praeitis, dabartis ir ateitis, ir iki ryto [[jis jau visai nebe tas pats žmogus]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "apie 100 puslapių, [[tobula gruodžiui]]"
    }
