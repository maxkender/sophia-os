  "3": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "2. [[Simyacı]], Paulo Coelho"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "genç bir çoban piramitlerin yanında bir hazine düşler, koyunlarını satıp yola çıkar ve [[yol ona altından fazlasını öğretir]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "200 sayfadan az, [[bir hafta sonu]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "kaydırmamın yerini alanlar: çantamda bir kitap, yürürken müzik ve telefonu yine de elime aldığımda [[Sophia uygulaması]]"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "oradaki bugünkü 5 dakikalık dersim: Rönesans neden İtalya'da doğdu"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[İnci]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeck. yoksul bir dalgıç, görülmüş en büyük inciyi bulur"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "doktor, tüccarlar, bütün kasaba onu istiyor ve hayali [[yavaş yavaş bir kâbusa dönüşüyor]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "100 sayfadan az, eski bir masal gibi yazılmış, tek akşamda biter"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[ve o final, cidden]]"
    }
   },
