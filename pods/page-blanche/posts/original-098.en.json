  "5": {
   "textes": {
    "T1": {
     "en": [
      "dont go on your phone first thing in the",
      "morning"
     ],
     "texte": "ask [[\"what would you do?\"]] instead of \"what do you do?\""
    },
    "T2": {
     "en": [
      "messages, news, tiktok, you're reacting to",
      "everyone else before you've even got out of bed"
     ],
     "texte": "\"one year in any city, which one?\" gets [[way more]] than small talk"
    },
    "T3": {
     "en": [
      "your brain gets a hit of",
      "dopamine before you've",
      "done anything"
     ],
     "texte": "even shy people [[have an answer]]"
    },
    "T4": {
     "en": [
      "and the rest of your",
      "day feels boring. give",
      "yourself the first 30",
      "minutes without your",
      "phone"
     ],
     "texte": "and their answer gives you [[three new things]] to ask about"
    }
   },
