  "5": {
   "textes": {
    "T1": {
     "en": [
      "dont go on your phone first thing in the",
      "morning"
     ],
     "fr": "touche pas à ton tel [[dès le réveil]]",
     "texte": "ne nyúlj a telódhoz [[rögtön ébredés után]]"
    },
    "T2": {
     "en": [
      "messages, news, tiktok, you're reacting to",
      "everyone else before you've even got out of bed"
     ],
     "fr": "messages, actus, tiktok, tu réagis [[à tout le monde]] avant même de sortir du lit",
     "texte": "üzenetek, hírek, tiktok, még fel sem keltél, és már [[mindenki másra]] reagálsz"
    },
    "T3": {
     "en": [
      "your brain gets a hit of",
      "dopamine before you've",
      "done anything"
     ],
     "fr": "ton cerveau prend [[un shot de dopamine]] avant que t'aies rien fait",
     "texte": "az agyad [[egy adag dopamint]] kap, mielőtt bármit csináltál volna"
    },
    "T4": {
     "en": [
      "and the rest of your",
      "day feels boring. give",
      "yourself the first 30",
      "minutes without your",
      "phone"
     ],
     "fr": "et le reste de ta journée [[paraît fade]]. offre-toi 30 minutes sans ton tel au réveil",
     "texte": "és a nap többi része [[unalmasnak tűnik]]. az első 30 percet töltsd telefon nélkül"
    }
   },
