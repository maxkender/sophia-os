     "en": [
      "learn to tolerate boring repetition"
     ],
     "texte": "3. [[Φαρενάιτ 451]], Ρέι Μπράντμπερι"
    },
    "T2": {
     "en": [
      "most success is less",
      "exciting than it looks"
     ],
     "texte": "ένας κόσμος όπου οι πυροσβέστες [[καίνε βιβλία]]"
    },
    "T3": {
     "en": [
      "it’s doing the same",
      "useful things for",
      "months after the",
      "novelty disappears"
     ],
     "texte": "ο Μόνταγκ τα καίει κάθε μέρα, ώσπου ένα βράδυ κρατάει ένα και [[αρχίζει να διαβάζει]]"
    },
    "T4": {
     "en": [
      "consistency gets powerful when other people get bored",
      "and move on"
     ],
     "texte": "γράφτηκε το 1953 και μιλάει ξεκάθαρα [[για εμάς και τις οθόνες μας]]"
    }
   },
