  "4": {
   "textes": {
    "T1": {
     "en": [
      "not reading books"
     ],
     "texte": "yatakta [[scroll at]]"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "bir göz açık, diğeri hâlâ uykuda: 40 dakika başkalarının hayatı, stresli haberler ve [[47 bildirim]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "daha kimseye tek kelime etmedin ama beynin [[şimdiden aşırı yüklendi]]. harika bir ısınma turu"
    },
    "T4": {
     "en": [
      "i struggled with stopping",
      "scrolling until i found this",
      "thing that blocks my apps",
      "until i read for 20 minutes"
     ],
     "texte": "ve sakın o scroll'u bir kitapla, bir podcast'le ya da [[Sophia uygulamasında]] 5 dakikalık bir dersle değiştirme"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "5": {
   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "kahvaltı yok, [[sadece kahve]]"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "aç karnına iki espresso ve öğlene kadar başka hiçbir şey"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "saat 10'da ellerin biraz titriyor ve odaklanman [[uçup gitti]]"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "11.40'ta klavyenin üstünde koca bir paket bisküvi yiyorsun. [[dengeli beslenme!!]]"
    }
   },
