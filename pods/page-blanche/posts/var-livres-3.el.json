  "5": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "4. [[Γράμμα μιας άγνωστης]], Τσβάιχ"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "ένας διάσημος συγγραφέας παίρνει ένα γράμμα από μια γυναίκα που δεν θυμάται καν. τον αγαπά κρυφά από τα 13 της και [[του τα λέει όλα]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "100 σελίδες, [[σκέτη γροθιά]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "και το βράδυ, παλιά έκανα ατελείωτο σκρολ, ενώ τώρα μαθαίνω κάτι καινούργιο σε 5 λεπτά στην [[εφαρμογή Sophia]]"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "χθες ήταν γιατί η Αναγέννηση ξεκίνησε στην Ιταλία. ακόμα το συζητάω"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "6": {
   "textes": {
    "T1": {
     "en": [
      "wake up before everyone else"
     ],
     "texte": "5. [[Ο Υπέροχος Γκάτσμπυ]] (1925)"
    },
    "T2": {
     "en": [
      "no messages, no notifications, no one needs you yet"
     ],
     "texte": "τρελά πάρτι κι ένας οικοδεσπότης [[που κανείς δεν ξέρει]]"
    },
    "T3": {
     "en": [
      "the first hour of the day is",
      "when your focus is at its",
      "best, so use it for your",
      "own goals"
     ],
     "texte": "έχει τη βίλα, τα λεφτά, τα πάρτι, αλλά θέλει [[ένα μόνο πράγμα]] στην απέναντι όχθη του κόλπου"
    },
    "T4": {
     "en": [
      "before anyone else can",
      "take your attention"
     ],
     "texte": "όσο προχωράς, [[τόσο πιο πολύ ραγίζουν όλα]]"
    },
    "T5": {
     "en": [
      "even 30 minutes earlier makes a difference"
     ],
     "texte": "Φιτζέραλντ, 180 σελίδες, [[ένα σαββατοκύριακο]]"
    }
   },
