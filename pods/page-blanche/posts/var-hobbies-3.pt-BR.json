  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "faça [[palavras cruzadas]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "uma dica te faz vasculhar todas as palavras que você conhece, e outra só sai [[quando você preenche o resto]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "vocabulário, memória e lógica juntos"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "e o café de domingo [[finalmente tem um propósito]]"
    }
   },
