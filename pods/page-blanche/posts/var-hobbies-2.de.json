    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "10/10 Hobbys, die dein Gehirn stärker machen"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(die Forschung bestätigt's)",
     "alignement": "droite"
    }
