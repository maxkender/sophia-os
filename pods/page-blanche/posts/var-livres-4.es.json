  "5": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "4. [[Cuento de Navidad]] (1843)"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickens. un viejo avaro recibe la visita de tres fantasmas en una sola noche"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "pasado, presente y futuro, y a la mañana siguiente [[ya no es el mismo hombre]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "unas 100 páginas, [[perfecto para diciembre]]"
    }
   },
   "images": {
