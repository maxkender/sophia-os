    "T4": {
     "en": [
      "books that survived 50–",
      "100+ years usually",
      "survived for a reason"
     ],
     "fr": "les livres qui ont tenu 50 à 100+ ans ont tenu pour une raison"
    },
    "T5": {
     "en": [
