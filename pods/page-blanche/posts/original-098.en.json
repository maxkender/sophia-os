  "3": {
   "textes": {
    "T1": {
     "en": [
      "understand it's all your fault"
     ],
     "texte": "[[notice one detail]] about them"
    },
    "T2": {
     "en": [
      "your job, your body, your grades, your habits, your",
      "position it's all your fault"
     ],
     "texte": "their book, their tote bag, the coffee they ordered. [[ask about it]]"
    },
    "T3": {
     "en": [
      "that sounds harsh, but",
      "it's actually good news"
     ],
     "texte": "\"is that book good?\" [[opens a whole topic]]"
    },
    "T4": {
     "en": [
      "if it's your fault, it's also",
      "in your control, you don't",
      "have to be the person",
      "you were yesterday, you",
      "can change"
     ],
     "texte": "people love talking about what they chose, and you never have to invent a subject, [[it's right in front of you]]"
    }
   },
