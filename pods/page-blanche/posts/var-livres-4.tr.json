  "6": {
   "textes": {
    "T1": {
     "en": [
      "get good at writing"
     ],
     "texte": "5. [[Siddhartha]]"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "Hermann Hesse'den, 150 sayfa civarı"
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "genç bir adam hayatın anlamını bulmak için evden ayrılır, zenginliği ve aşkı dener, [[onu bir nehrin kıyısında bulur]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
      "marketing, leadership, sales, and building an",
      "audience"
     ],
     "texte": "sade cümleler, kısa bölümler ve günlerce süren bir huzur. [[bir hafta sonunu bitirmek için mükemmel kitap]]"
    }
