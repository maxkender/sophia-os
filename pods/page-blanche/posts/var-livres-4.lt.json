  "3": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "2. [[Alchemikas]], Paulo Coelho"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "jaunas piemuo sapnuoja lobį prie piramidžių, parduoda avis ir iškeliauja, o [[kelias jį išmoko daugiau nei auksas]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "iki 200 puslapių, [[savaitgalis]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "kas pakeitė mano skrolinimą: knyga rankinėje, muzika einant ir [[programėlė Sophia]], kai vis tiek paimu telefoną"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "šiandienos 5 minučių pamoka ten: kodėl Renesansas gimė Italijoje"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[Perlas]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeckas. vargšas naras randa didžiausią kada nors matytą perlą"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "gydytojas, prekeiviai, visas miestas jo nori, o jo svajonė [[pamažu virsta košmaru]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "mažiau nei 100 puslapių, parašyta kaip sena pasaka, perskaitoma per vakarą"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[o ta pabaiga, rimtai]]"
    }
   },
