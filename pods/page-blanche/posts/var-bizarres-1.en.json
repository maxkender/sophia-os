  "3": {
   "textes": {
    "T1": {
     "en": [
      "say no to almost everything"
     ],
     "texte": "talk to yourself [[by your name]]"
    },
    "T2": {
     "en": [
      "warren buffett said really successful people say",
      "no to almost everything"
     ],
     "texte": "when stress hits, talk to yourself the way you'd talk to a friend"
    },
    "T3": {
     "en": [
      "stop being a people's",
      "pleaser"
     ],
     "texte": "it sounds a little [[crazy]], i know"
    },
    "T4": {
     "en": [
      "you'll have less time for",
      "what actually matters"
     ],
     "texte": "but studies found it [[calms you down]]"
    },
    "T5": {
     "en": [
      "protect your time like",
      "it's the most valuable",
      "thing you have"
     ],
     "texte": "your name puts a little distance between you and the problem"
    }
   },
