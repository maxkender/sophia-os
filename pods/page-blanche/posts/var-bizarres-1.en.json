  "6": {
   "textes": {
    "T1": {
     "en": [
      "you reach for your phone the",
      "second nothing is happening"
     ],
     "fr": "tu sors ton tel [[à la seconde où]] il se passe rien",
     "texte": "chew gum while you study, [[seriously]]"
    },
    "T2": {
     "en": [
      "waiting 30 seconds,",
      "standing in a queue, sitting",
      "in a lift, you instantly need",
      "input"
     ],
     "fr": "30 secondes d'attente, une file, un ascenseur… et [[il te faut direct un truc à regarder]]",
     "texte": "some studies link chewing gum to [[feeling more alert]] and staying focused longer on boring tasks"
    },
    "T3": {
     "en": [
      "boredom is where your",
      "brain gets a chance to",
      "wander, reflect and",
      "connect ideas"
     ],
     "fr": "l'ennui, c'est le moment où ton cerveau peut divaguer, réfléchir et faire des liens",
     "texte": "your jaw keeps moving, so your body stays a little more [[switched on]] and your mind drifts less"
    },
    "T4": {
     "en": [
      "stop deleting every empty",
      "moment"
     ],
     "fr": "[[arrête de remplir]] chaque temps mort",
     "texte": "keep a pack next to your notes"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "fr": "[[écoute tes pensées]]",
     "texte": "[[easiest one on the list]]"
    }
   },
