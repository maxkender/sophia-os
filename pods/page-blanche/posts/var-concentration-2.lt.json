  "4": {
   "textes": {
    "T1": {
     "en": [
      "they read classic books written",
      "by the greats"
     ],
     "texte": "užpildyti [[kiekvieną laukimą]] telefonu"
    },
    "T2a": {
     "en": [
      "they know endless tiktok scrolling rots their",
      "attention"
     ],
     "texte": "eilė, autobusas, mikrobangė, liftas: ir telefonas jau rankoje"
    },
    "T2b": {
     "en": [
      "instead, they read ideas that",
      "survived decades or",
      "centuries"
     ],
     "texte": "tavo smegenys [[niekada neturi tuščios minutės]] atsikvėpti"
    },
    "T3": {
     "en": [
      "from people who thought",
      "deeply about psychology,",
      "power, business, and human",
      "nature"
     ],
     "texte": "tad vos darbas sulėtėja, jos [[ieško kažko kito]] iš įpročio, kiekvieną kartą"
    },
    "T4": {
     "en": [
      "if you’re stuck on tiktok, you",
      "can try readup which blocks",
      "your apps until you read"
     ],
     "texte": "anksčiau skrolinau visą dieną, dabar per 5 min išmokstu ką nors naujo [[programėlėje Sophia]]"
    }
   },
   "images": {
    "I1": "sophia_capture",
    "I2": "sophia_appstore"
   },
