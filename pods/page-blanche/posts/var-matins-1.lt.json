  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "atidėk žadintuvą [[6 kartus iš eilės]]"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "kas 9 minutes vėl užmiegi, o žadintuvas tave ištraukia iš miego. labai poilsinga"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "po valandos pagaliau keliesi, [[miego dar daugiau nei per pirmą skambutį]], o liko 12 minučių"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "dantų šepetėlis vienoje rankoje, batas kitoje, ir lauk pro duris bėgte. [[visiška ramybė]]"
    }
   },
   "images": {
    "I1": {
