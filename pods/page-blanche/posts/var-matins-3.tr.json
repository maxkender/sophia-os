   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "kendine [[6'da koşu]] sözü ver"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "alarm 5.45'te, spor ayakkabılar yatağın dibinde, kıyafet sandalyede"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "6.01'de dışarısının [[biraz fazla soğuk]] olduğuna karar veriyorsun"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "tekrar uyuyorsun ve 8'de [[bonus suçluluk duygusuyla]] kalkıyorsun. tam bir atlet !!"
    }
   },
