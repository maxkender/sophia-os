  "5": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "kahvaltıda « [[sadece bir bölüm]] »"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "mısır gevreği kasesi ekranın önünde, 20 dakika nasılsa yeter diyorsun"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "bölüm heyecanlı yerde bitiyor, sonraki kendi başlıyor ve gevrekler [[lapa oluyor]]"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "8.50'de hâlâ pijamayla 3. bölümdesin ve [[tren sensiz çoktan gitti]]. helal olsun"
    }
   },
