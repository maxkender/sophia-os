  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "mach was [[mit deinen Händen]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "Töpfern, Stricken, Holz: deine Hände probieren, deine Augen prüfen und [[dein Gehirn plant jede Bewegung]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "eine Studie verbindet Handarbeit mit [[weniger Gedächtnisproblemen]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "und am Ende hast du was Echtes, nicht [[noch ein gespeichertes Video]]"
    }
   },
