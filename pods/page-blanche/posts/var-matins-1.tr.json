  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "[[perdeleri kapalı]] tut"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "gün ışığı yok, sadece telefonun ışığı. beynin hâlâ gece 3 olduğunu sanıyor"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "yani uyku modunda kalıyor ve sen mutfakta [[kafası karışık bir zombi]] gibi dolanıyorsun"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "ışık zaten [[sabah insanlarına göre]]"
    }
   },
   "images": {
