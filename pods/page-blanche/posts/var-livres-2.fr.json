     "en": [
      "play and study chess"
     ],
     "texte": "2. [[Soie]], Baricco"
    },
    "T2": {
     "en": [
      "chess forces you to calculate ahead, recognise",
      "patterns, and constantly ask “what am I missing?”"
     ],
     "texte": "dans les années 1860, un marchand de vers à soie français part au Japon, et un regard change sa vie"
    },
    "T3": {
     "en": [
      "don't just play random",
      "games, analyse them",
      "afterwards"
     ],
     "texte": "des chapitres minuscules, parfois [[une page à peine]]"
    },
    "T4": {
     "en": [
      "science proves that",
      "even 20–30 minutes a",
      "day gives your brain",
      "deliberate problem-",
      "solving practice"
     ],
     "texte": "ça se lit comme une chanson, doux et étrange, et tu [[le finis en une soirée]] sans t'en rendre compte"
    }
