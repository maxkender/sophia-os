  "4": {
   "textes": {
    "T1": {
     "en": [
      "not reading books"
     ],
     "texte": "[[skrolink]] lovoje"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "viena akis atmerkta, kita dar miega: 40 minučių svetimų gyvenimų, stresą keliančių naujienų ir [[47 pranešimų]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "dar niekam nepasakei nė žodžio, o tavo smegenys [[jau visiškai perkrautos]]. puikus apšilimas"
    },
    "T4": {
     "en": [
      "i struggled with stopping",
      "scrolling until i found this",
      "thing that blocks my apps",
      "until i read for 20 minutes"
     ],
     "texte": "ir jokiu būdu niekada nekeisk to skrolinimo į knygą, podkastą ar 5 min pamoką [[programėlėje Sophia]]"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "5": {
   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "jokių pusryčių, [[tik kava]]"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "du espresso tuščiu skrandžiu ir daugiau nieko iki pietų"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "10 val. rankos šiek tiek dreba, o susikaupimas [[dingo]]"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "11:40 suvalgai visą pakelį sausainių virš klaviatūros. [[subalansuota!!]]"
    }
   },
