  "5": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "4. [[Karácsonyi ének]] (1843)"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickens. egy kapzsi öregembert egyetlen éjszaka alatt három szellem látogat meg"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "múlt, jelen és jövő, és reggelre [[már egyáltalán nem ugyanaz az ember]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "nagyjából 100 oldal, [[tökéletes decemberre]]"
    }
   },
