   "textes": {
    "T1": {
     "en": [
      "learn to tolerate boring repetition"
     ],
     "texte": "1. [[Beyaz Geceler]], Dostoyevski"
    },
    "T2": {
     "en": [
      "most success is less",
      "exciting than it looks"
     ],
     "texte": "dört gece, bir köprüde tanışan iki yabancı"
    },
    "T3": {
     "en": [
      "it’s doing the same",
      "useful things for",
      "months after the",
      "novelty disappears"
     ],
     "texte": "kız başka birini bekliyor, sen yine de [[her sayfada adam için umutlanıyorsun]]"
    },
    "T4": {
     "en": [
      "consistency gets powerful when other people get bored",
      "and move on"
     ],
     "texte": "sadece 70 sayfa civarı, [[okuyacağın en kısa kalp kırıklığı]]"
    }
   },
   "images": {
