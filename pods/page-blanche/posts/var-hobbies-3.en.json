 "post_id": "var-hobbies-3",
 "slides": {
  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "hobbies that train your brain without you noticing"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(science backed)",
     "alignement": "droite"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_032ce839.jpg",
