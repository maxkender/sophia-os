  "6": {
   "textes": {
    "T1": {
     "en": [
      "get good at writing"
     ],
     "texte": "5. [[Siddhartha]]"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "de Hermann Hesse, unas 150 páginas"
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "un joven deja su casa para buscar el sentido de la vida, prueba la riqueza y el amor, y [[lo encuentra junto a un río]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
      "marketing, leadership, sales, and building an",
      "audience"
     ],
     "texte": "frases simples, capítulos cortos y una calma que te dura días. [[el libro perfecto para cerrar el finde]]"
    }
   },
