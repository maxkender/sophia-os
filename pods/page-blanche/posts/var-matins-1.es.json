  "4": {
   "textes": {
    "T1": {
     "en": [
      "not reading books"
     ],
     "texte": "[[scrollea]] en la cama"
    },
    "T2": {
     "en": [
      "if most of what you consume",
      "is short posts, clips, and",
      "headlines, your brain rarely",
      "has to hold attention for long"
     ],
     "texte": "un ojo abierto y el otro dormido: 40 min de vidas ajenas, noticias que estresan y [[47 notificaciones]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea across pages, remember",
      "context, and resist the urge for",
      "something new"
     ],
     "texte": "todavía no has saludado a nadie y tu cerebro ya está [[a tope de saturación]]. qué buen calentamiento"
    },
    "T4": {
     "en": [
      "i struggled with stopping",
      "scrolling until i found this",
      "thing that blocks my apps",
      "until i read for 20 minutes"
     ],
     "texte": "y sobre todo, nunca cambies ese scroll por un libro, un pódcast o 5 min de lección en [[la app Sophia]]"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "5": {
   "textes": {
    "T1a": {
     "en": [
      "5. do your hardest task first"
     ],
     "texte": "nada de desayuno, [[solo café]]"
    },
    "T1b": {
     "en": [
      "your prefrontal cortex",
      "handles planning, focus and",
      "self-control"
     ],
     "texte": "dos expresos con el estómago vacío y nada más hasta mediodía"
    },
    "T2": {
     "en": [
      "don't waste your freshest",
      "attention on emails and",
      "tiny tasks"
     ],
     "texte": "a las 10 tiemblan un poco las manos y la concentración [[se esfumó]]"
    },
    "T3": {
     "en": [
      "spend the first 60–90",
      "minutes on the thing",
      "you're most likely to avoid",
      "late"
     ],
     "texte": "a las 11:40 te comes un paquete de galletas sobre el teclado. [[¡¡qué equilibrio!!]]"
    }
   },
