  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "pospón la alarma [[6 veces seguidas]]"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "cada 9 min te vuelves a dormir y la alarma te arranca del sueño. superrelajante"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "al cabo de una hora te levantas [[con más sueño que en la primera alarma]] y te quedan 12 min"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "cepillo de dientes en una mano, zapato en la otra, y sales corriendo por la puerta. [[paz absoluta]]"
    }
   },
   "images": {
