    },
    "T2": {
     "en": [
      "your brain loves evidence that proves what you",
      "already believe"
     ],
     "texte": "hepsi öğlene kadar, tabii ki. spor, mailler, vergiler, anneanneyi ara"
    },
    "T3": {
     "en": [
      "actively look for the",
      "strongest argument",
      "against your opinion"
     ],
     "texte": "11.58'de tam olarak bir tanesini işaretledin: [[listeyi yazmak]]"
    },
    "T4": {
     "en": [
      "getting smarter",
      "means getting better",
      "at noticing when your",
      "own thinking is wrong"
     ],
     "texte": "sonra öğleden sonra vicdan azabı çek, akşam [[daha da uzun]] yeniden yaz. yarın görüşürüz!!"
