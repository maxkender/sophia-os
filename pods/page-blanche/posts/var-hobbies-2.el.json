  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "μαγείρεψε [[χωρίς συνταγή]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "άνοιξε το ψυγείο, δες τι έχει και σκέψου ένα πιάτο. χρόνος, δοκιμή, διορθώσεις: [[ο εγκέφαλός σου τα κάνει όλα]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "οργάνωση και δημιουργικότητα μαζί"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "και το φαγητό είναι [[η ανταμοιβή]]"
    }
   },
