  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "kurk ką nors [[savo rankomis]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "keramika, mezgimas, medis: rankos bando, akys tikrina, o [[smegenys planuoja kiekvieną judesį]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "tyrimas sieja rankdarbius su [[mažiau atminties problemų]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "ir galiausiai turi tikrą daiktą, o ne [[dar vieną išsaugotą vaizdo įrašą]]"
    }
   },
   "images": {
