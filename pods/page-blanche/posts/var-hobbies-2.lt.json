    }
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "rask kelią [[be GPS]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "sek žemėlapį savo galvoje ir pastebėk gatves, parduotuves, [[posūkius]]"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "Londono taksistų smegenyse [[atminties zona yra didesnė]]"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "anksčiau be galo skrolinau, o dabar telefone darau [[5 min. pamoką programėlėje Sophia]]"
    }
   },
