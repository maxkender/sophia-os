  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "szundizz [[hatszor egymás után]]"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "9 percenként visszaalszol, aztán az ébresztő kirángat belőle. nagyon pihentető"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "egy óra múlva végre felkelsz, [[fáradtabban, mint az első csörgésnél]], és 12 perced maradt"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "egyik kezedben fogkefe, a másikban cipő, rohanás ki az ajtón. [[teljes nyugalom]]"
    }
   },
