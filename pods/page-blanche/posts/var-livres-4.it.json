  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[La perla]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeck. un pescatore povero trova la perla più grande mai vista"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "il dottore, i mercanti, tutta la città la vogliono, e il suo sogno [[diventa piano piano un incubo]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "meno di 100 pagine, scritto come una vecchia favola, finito in una sera"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[e quel finale, poi]]"
    }
   },
