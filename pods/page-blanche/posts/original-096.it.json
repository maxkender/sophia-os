  "5": {
   "textes": {
    "T1": {
     "en": [
      "play chess"
     ],
     "fr": "gioca a [[scacchi]]",
     "texte": "segui la tua [[curiosità]]"
    },
    "T2": {
     "en": [
      "chess forces you to think ahead, spot patterns,",
      "and constantly ask \"what am i missing?\""
     ],
     "fr": "gli scacchi ti fanno [[ragionare in anticipo]], vedere schemi e chiederti \"cosa mi sfugge?\"",
     "texte": "lascia perdere il programma perfetto, impara [[quello che oggi ti ha incuriosito]]"
    },
    "T3": {
     "en": [
      "don't just play random",
      "games, analyse them",
      "afterwards"
     ],
     "fr": "non giocare partite a caso, [[analizzale]] dopo",
     "texte": "una parola che non conoscevi, [[una domanda a caso]]"
    },
    "T4": {
     "en": [
      "even 20–30 minutes a",
      "day trains your brain",
      "to solve problems",
      "instead of just reacting"
     ],
     "fr": "[[20–30 min al giorno]] allenano il cervello a [[risolvere problemi]] invece di reagire",
     "texte": "quando sei tu a voler sapere, [[ti resta molto di più]] dei compiti obbligati"
    }
   },
