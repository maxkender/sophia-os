  "2": {
   "textes": {
    "T1": {
     "en": [
      "watching everything at 2x speed"
     ],
     "fr": "tout regarder [[en vitesse x2]]",
     "texte": "verlo todo [[a velocidad x2]]"
    },
    "T2": {
     "en": [
      "youtube, podcasts, lectures, even voice notes from",
      "your friends, everything gets sped up these days"
     ],
     "fr": "vidéos, podcasts, cours, même les vocaux de tes potes, aujourd'hui [[tout passe en accéléré]]",
     "texte": "videos, podcasts, clases, hasta los audios de tus amigos, hoy en día [[todo va acelerado]]"
    },
    "T3": {
     "en": [
      "after a while,",
      "anything at normal",
      "speed starts to feel",
      "painfully slow"
     ],
     "fr": "à force, tout ce qui passe à vitesse normale te paraît [[atrocement lent]]",
     "texte": "al final, cualquier cosa a velocidad normal se te hace [[eternamente lenta]]"
    },
    "T4": {
     "en": [
      "so a real",
      "conversation or a",
      "book feels too",
      "slow to focus on"
     ],
     "fr": "du coup une vraie discussion ou un livre, [[t'arrives plus à suivre]]",
     "texte": "así que una charla real o un libro [[se te hacen lentísimos]]"
    }
   },
   "images": {
    "I1": "garder"
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "reading AI summaries of everything"
     ],
     "fr": "ne lire que [[des résumés par IA]]",
     "texte": "leer [[resúmenes de IA]] de todo"
    },
    "T2": {
     "en": [
      "articles, youtube videos, google summaries,, you",
      "read the summary and skip the real thing"
     ],
     "fr": "articles, vidéos, résumés de recherche… tu lis le résumé et [[tu zappes le vrai truc]]",
     "texte": "artículos, videos, resúmenes del buscador,, lees el resumen y [[te saltas lo de verdad]]"
    },
    "T4": {
     "en": [
      "your brain stops",
      "practicing",
      "following an idea",
      "from start to",
      "finish"
     ],
     "fr": "ton cerveau perd l'habitude de [[suivre une idée]] du début à la fin",
     "texte": "tu cerebro deja de practicar [[seguir una idea]] de principio a fin"
    },
    "T3": {
     "en": [
      "so anything without a summary starts feeling",
      "impossible to get through"
     ],
     "fr": "du coup tout ce qui n'a pas de résumé te paraît [[impossible à finir]]",
     "texte": "y todo lo que no tiene resumen empieza a parecer [[imposible de terminar]]"
    }
   },
