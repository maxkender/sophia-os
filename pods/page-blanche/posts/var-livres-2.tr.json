  "5": {
   "textes": {
    "T1": {
     "en": [
      "get good at writing"
     ],
     "texte": "4. [[Küçük Prens]]"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "Saint-Exupéry, 100 sayfadan kısa"
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "çölde mahsur kalan bir pilot, minicik bir gezegenden gelen küçük bir çocukla tanışıyor, ve çocuk [[en iyi soruları soruyor]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
      "marketing, leadership, sales, and building an",
      "audience"
     ],
     "texte": "çocuk kitabı sanıyorsun, sonra bir cümle seni vuruyor ve anlıyorsun: [[hiçbir zaman çocuklar için değildi]]"
    }
