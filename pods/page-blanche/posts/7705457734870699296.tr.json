  "6": {
   "textes": {
    "T1": {
     "en": [
      "wake up before everyone else"
     ],
     "texte": "[[herkesten önce]] uyan"
    },
    "T2": {
     "en": [
      "no messages, no notifications, no one needs you yet"
     ],
     "texte": "mesaj yok, bildirim yok, [[henüz kimsenin sana ihtiyacı yok]]"
    },
    "T3": {
     "en": [
      "the first hour of the day is",
      "when your focus is at its",
      "best, so use it for your",
      "own goals"
     ],
     "texte": "günün ilk saati odağının [[en güçlü]] olduğu an, onu kendi hedeflerin için kullan"
    },
    "T4": {
     "en": [
      "before anyone else can",
      "take your attention"
     ],
     "texte": "başkası [[dikkatini çalmadan]] önce"
    },
    "T5": {
     "en": [
      "even 30 minutes earlier makes a difference"
     ],
     "texte": "[[30 dakika erken]] kalkmak bile fark yaratır"
    }
