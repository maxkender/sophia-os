  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "hobbies que treinam seu cérebro sem você perceber"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(comprovado pela ciência)",
     "alignement": "droite"
    }
   },
