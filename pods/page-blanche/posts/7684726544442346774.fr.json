  "2": {
   "textes": {
    "T1": {
     "en": [
      "1. take real breaks"
     ],
     "fr": "1. fais de [[vraies pauses]]"
    },
    "T2": {
     "en": [
      "doomscrolling between work",
      "blocks is not rest, that's why",
      "you always feel tired"
     ],
     "fr": "[[scroller]] entre deux sessions de travail, [[ce n'est pas du repos]] : voilà pourquoi t'es crevé"
    },
    "T3": {
     "en": [
      "you're just swapping",
      "one stream of",
      "stimulation for another"
     ],
     "fr": "tu remplaces juste un flux de stimulation par un autre"
    },
    "T4": {
     "en": [
      "take 10 minutes with",
      "no screen"
     ],
     "fr": "prends 10 minutes sans écran"
    },
    "T5": {
     "en": [
      "walk, stretch, stare outside, then come",
      "back with an actually quieter brain"
     ],
     "fr": "marche, étire-toi, regarde dehors, puis reviens avec un cerveau vraiment plus calme"
    }
   },
   "images": {
    "I1": "garder"
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "fr": "2. arrête [[d'essayer d'être multitâche]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "fr": "chaque changement de tâche force ta mémoire de travail à lâcher un contexte pour en charger un autre"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "fr": "faire 2 choses à la fois [[semble productif]], mais ton cerveau ne fait que se réorienter"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "fr": "une tâche, un onglet, [[jusqu'à ce que ce soit fini]]"
    }
   },
   "images": {
    "I1": "garder"
   }
  },
