  "4": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "escribe [[a mano]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "un diario, una carta, tus apuntes: [[boli, no teclado]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "un estudio de 2024: el cerebro está [[mucho más conectado]] al escribir a mano que al teclear"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "es más lento, y esa es la gracia: tienes que [[elegir tus palabras]] antes de ponerlas en el papel"
    }
   },
