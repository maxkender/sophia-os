  "2": {
   "textes": {
    "T1": {
     "en": [
      "say no to almost everything"
     ],
     "fr": "dis [[non]] à presque tout",
     "texte": "mondj [[nemet]] szinte mindenre"
    },
    "T2": {
     "en": [
      "warren buffett said really successful people say",
      "no to almost everything"
     ],
     "fr": "selon warren buffett, ceux qui réussissent vraiment [[disent non à presque tout]]",
     "texte": "warren buffett szerint a tényleg sikeresek [[szinte mindenre nemet mondanak]]"
    },
    "T3": {
     "en": [
      "stop being a people's",
      "pleaser"
     ],
     "fr": "[[arrête de plaire à tout le monde]]",
     "texte": "[[ne akarj mindenkinek megfelelni]]"
    },
    "T4": {
     "en": [
      "you'll have less time for",
      "what actually matters"
     ],
     "fr": "sinon t'as [[moins de temps]] pour l'essentiel",
     "texte": "különben [[kevesebb időd]] marad arra, ami számít"
    },
    "T5": {
     "en": [
      "protect your time like",
      "it's the most valuable",
      "thing you have"
     ],
     "fr": "protège ton temps comme [[ce que t'as de plus précieux]]",
     "texte": "úgy vigyázz az idődre, mint [[a legértékesebb dolgodra]]"
    }
   },
