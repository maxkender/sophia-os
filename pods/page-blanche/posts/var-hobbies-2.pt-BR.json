  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "cozinhe [[sem receita]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "abra a geladeira, veja o que tem e invente um prato. tempo, tempero, ajustes: [[seu cérebro comanda tudo]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "planejamento e criatividade juntos"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "e o jantar é [[a recompensa]]"
    }
   },
