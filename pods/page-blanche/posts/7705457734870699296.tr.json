  "3": {
   "textes": {
    "T1": {
     "en": [
      "understand it's all your fault"
     ],
     "texte": "[[her şey senin suçun]], kabul et"
    },
    "T2": {
     "en": [
      "your job, your body, your grades, your habits, your",
      "position it's all your fault"
     ],
     "texte": "işin, vücudun, notların, alışkanlıkların, durumun, [[hepsi senin suçun]]"
    },
    "T3": {
     "en": [
      "that sounds harsh, but",
      "it's actually good news"
     ],
     "texte": "kulağa sert geliyor ama aslında iyi haber"
    },
    "T4": {
     "en": [
      "if it's your fault, it's also",
      "in your control, you don't",
      "have to be the person",
      "you were yesterday, you",
      "can change"
     ],
     "texte": "senin suçunsa [[senin elinde]] demektir, dünkü kişi olarak kalmak zorunda değilsin, değişebilirsin"
    }
   },
