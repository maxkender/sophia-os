  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "koch [[ohne Rezept]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "öffne den Kühlschrank, schau, was da ist, und erfinde ein Gericht. Timing, Abschmecken, Retten: [[dein Gehirn macht alles]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "Planung und Kreativität in einem"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "und das Essen ist [[die Belohnung]]"
    }
   },
