  "5": {
   "textes": {
    "T1": {
     "en": [
      "they tolerate long periods with",
      "no reward"
     ],
     "texte": "[[labai saldūs pusryčiai]] prieš paskaitas"
    },
    "T2": {
     "en": [
      "they can keep working when",
      "nobody is watching, nothing",
      "is going viral, and the results",
      "still look unimpressive"
     ],
     "texte": "dribsniai, bandelės, saldi kava. valandą tau gera, tada cukrus kraujyje krenta, o [[kartu ir dėmesys]]"
    },
    "T3": {
     "en": [
      "most people need constant",
      "proof that something is",
      "working"
     ],
     "texte": "nuovargis 10 val. nėra tingumas, [[tai cukraus kritimas]]"
    },
    "T4": {
     "en": [
      "successful people can stay",
      "consistent long enough for the",
      "payoff to arrive."
     ],
     "texte": "pridėk baltymų: kiaušinių, jogurto, avižų. [[ištversi iki pietų]]"
    }
   },
