 "post_id": "var-hobbies-2",
 "slides": {
  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 hobbies to make you",
      "extremely intelligent"
     ],
     "texte": "10/10 hobių, kurie sustiprina tavo smegenis"
    },
    "T2": {
     "en": [
      "(neuroscience approved)"
     ],
     "texte": "(mokslas patvirtina)",
     "alignement": "droite"
    }
   },
   "images": {
