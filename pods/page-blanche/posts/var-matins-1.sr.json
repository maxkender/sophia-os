  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "drži [[zavese navučene]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "ni zraka dnevnog svetla, samo svetlo telefona. mozak misli da je 3 ujutru"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "pa ostaje u režimu spavanja, a ti lutaš po kuhinji kao [[potpuno izgubljeni zombi]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "svetlo je ionako [[za jutarnje tipove]]"
    }
   },
