  "5": {
   "textes": {
    "T1": {
     "en": [
      "never reading a full book"
     ],
     "fr": "[[jamais finir]] un livre",
     "texte": "[[nunca acabar]] un libro"
    },
    "T2": {
     "en": [
      "we are entering a LITERARY CRISIS. less people are",
      "reading than ever before"
     ],
     "fr": "on entre dans une [[CRISE DE LA LECTURE]]. les gens lisent moins que [[jamais]]",
     "texte": "estamos entrando en una [[CRISIS LITERARIA]]. la gente lee menos que [[nunca]]"
    },
    "T3": {
     "en": [
      "books force you to follow one",
      "idea for whole chapters, and",
      "resist the urge for something",
      "new"
     ],
     "fr": "[[un livre te fait suivre une idée sur des chapitres entiers]] et résister à l'envie de zapper",
     "texte": "[[un libro te obliga a seguir una idea durante capítulos enteros]] y a resistir las ganas de algo nuevo"
    },
    "T4": {
     "en": [
      "if you struggle with",
      "doomscrolling, i recommend",
      "this thing that blocks tiktok",
      "until i read a book for 20",
      "minutes"
     ],
     "fr": "si tu [[doomscrolles]], tente une vraie leçon plutôt qu'un résumé. mes 5 min du jour sur [[l'appli Sophia]] : Camus et Sisyphe",
     "texte": "si haces [[doomscroll]], prueba una lección entera, no un resumen. hoy, 5 min en [[la app Sophia]]: por qué el cielo es azul"
