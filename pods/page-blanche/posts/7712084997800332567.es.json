   "textes": {
    "T1": {
     "en": [
      "watching everything at 2x speed"
     ],
     "fr": "tout regarder [[en vitesse x2]]",
     "texte": "verlo todo [[a velocidad x2]]"
    },
    "T2": {
     "en": [
      "lectures, podcasts and",
      "youtube videos go in so",
      "fast that your brain never",
      "gets time to store them"
     ],
     "fr": "cours, podcasts et vidéos défilent si vite que ton cerveau [[a jamais le temps de les ranger]]",
     "texte": "clases, podcasts y videos entran tan rápido que tu cerebro [[nunca tiene tiempo de guardarlos]]"
    },
    "T3": {
     "en": [
      "it feels like learning, but",
      "a week later it's gone"
     ],
     "fr": "tu crois apprendre, mais [[8 jours après, plus rien]]",
     "texte": "parece aprender, pero [[a los 7 días, nada]]"
    },
    "T4": {
     "en": [
      "slow it down and",
      "actually think about",
      "what you hear"
     ],
     "fr": "ralentis et [[réfléchis vraiment]] à ce que t'entends",
     "texte": "ve más despacio y [[piensa de verdad]] en lo que oyes"
    },
