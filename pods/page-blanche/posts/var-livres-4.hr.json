     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "4. [[Božićna priča]] (1843)"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickens. pohlepnog starog škrtca u samo jednoj noći posjete čak tri duha"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "prošlost, sadašnjost i budućnost, a do jutra on [[više uopće nije isti čovjek]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "oko 100 stranica, [[savršeno za prosinac]]"
    }
