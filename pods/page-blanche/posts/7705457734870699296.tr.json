     "en": [
      "say no to almost everything"
     ],
     "texte": "neredeyse her şeye [[hayır de]]"
    },
    "T2": {
     "en": [
      "warren buffett said really successful people say",
      "no to almost everything"
     ],
     "texte": "warren buffett'a göre gerçekten başarılı insanlar [[neredeyse her şeye hayır der]]"
    },
    "T3": {
     "en": [
      "stop being a people's",
      "pleaser"
     ],
     "texte": "[[herkesi memnun etmeye çalışma]]"
    },
    "T4": {
     "en": [
      "you'll have less time for",
      "what actually matters"
     ],
     "texte": "yoksa önemli şeylere [[daha az vaktin]] kalır"
    },
    "T5": {
     "en": [
      "protect your time like",
      "it's the most valuable",
      "thing you have"
     ],
     "texte": "zamanını [[sahip olduğun en değerli şeymiş]] gibi koru"
    }
