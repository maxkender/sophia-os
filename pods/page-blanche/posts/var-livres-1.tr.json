       703,
       566
      ]
     }
    }
   }
  },
  "5": {
   "textes": {
    "T1": {
     "en": [
      "wake up before everyone else"
     ],
     "texte": "4. Albert Camus'den [[Yabancı]]"
    },
    "T2": {
     "en": [
      "no messages, no notifications, no one needs you yet"
     ],
     "texte": "ilk cümlesi [[edebiyatın en ünlü cümlelerinden biri]]"
    },
    "T3": {
     "en": [
      "the first hour of the day is",
      "when your focus is at its",
      "best, so use it for your",
      "own goals"
     ],
     "texte": "herkesin ondan beklediği duyguları taklit etmeyen bir adam ve [[bunu ona affetmeyen bir dünya]]"
    },
    "T4": {
     "en": [
      "before anyone else can",
      "take your attention"
     ],
     "texte": "kısa, sade cümleler, [[tuhaf şekilde büyüleyici]]"
    },
    "T5": {
     "en": [
      "even 30 minutes earlier makes a difference"
     ],
     "texte": "150 sayfadan kısa, [[hafta sonu için birebir]]"
    }
   },
