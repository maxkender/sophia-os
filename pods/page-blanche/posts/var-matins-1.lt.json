   "textes": {
    "T1": {
     "en": [
      "challenge your own biases"
     ],
     "texte": "sudaryk [[23 punktų]] sąrašą"
    },
    "T2": {
     "en": [
      "your brain loves evidence that proves what you",
      "already believe"
     ],
     "texte": "viskas iki pietų. sportas, laiškai, mokesčiai, paskambinti močiutei"
    },
    "T3": {
     "en": [
      "actively look for the",
      "strongest argument",
      "against your opinion"
     ],
     "texte": "11:58 sąraše nubrauktas lygiai vienas punktas: [[parašyti sąrašą]]"
    },
    "T4": {
     "en": [
      "getting smarter",
      "means getting better",
      "at noticing when your",
      "own thinking is wrong"
     ],
     "texte": "tada visą popietę graužkis ir vakare perrašyk jį [[dar ilgesnį]]. iki rytojaus!!"
    }
