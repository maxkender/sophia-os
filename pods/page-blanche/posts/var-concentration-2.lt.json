     ],
     "texte": "konspektai [[5 spalvomis]]"
    },
    "T2": {
     "en": [
      "they constantly look for",
      "ways to make one hour of",
      "work create more than",
      "one hour of value"
     ],
     "texte": "penki žymekliai, tobuli pavadinimai, perrašytas puslapis, nes vienas žodis buvo negražus"
    },
    "T3": {
     "en": [
      "software, systems,",
      "content, capital,",
      "automation, teams"
     ],
     "texte": "rankos užimtos, o [[smegenys atsijungia]]"
    },
    "T4": {
     "en": [
      "they’re not just trying to",
      "work harder, they’re trying"
     ],
     "texte": "rašyk netvarkingai, tada [[pasitikrink save]] be užrašų"
