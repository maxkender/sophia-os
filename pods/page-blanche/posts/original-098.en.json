  "1": {
   "textes": {
    "T1": {
     "en": [
      "10/10 uncommon habits of",
      "extremely successful people"
     ],
     "texte": "how to never run out of things to say"
    },
    "T2": {
     "en": [
      "(niche edition)"
     ],
     "texte": "(even with strangers)",
     "alignement": "droite"
    }
   },
