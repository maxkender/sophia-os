     ],
     "texte": "sve do podneva, naravno. teretana, mailovi, porez, nazvati baku"
    },
    "T3": {
     "en": [
      "actively look for the",
      "strongest argument",
      "against your opinion"
     ],
     "texte": "u 11:58 je od svega prekrižena točno jedna: [[napisati popis]]"
    },
