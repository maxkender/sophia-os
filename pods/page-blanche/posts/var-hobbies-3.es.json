  "6": {
   "textes": {
    "T1": {
     "en": [
      "never miss twice"
     ],
     "texte": "haz [[crucigramas]]"
    },
    "T2": {
     "en": [
      "missed the gym today? fine. ate badly? move on.",
      "wasted three hours scrolling? don't waste the next",
      "three."
     ],
     "texte": "una pista te hace buscar entre todas las palabras que sabes, y otra solo sale [[cuando rellenas las demás]]"
    },
    "T3": {
     "en": [
      "the real damage isn't",
      "making a mistake."
     ],
     "texte": "vocabulario, memoria y lógica a la vez"
    },
    "T4": {
     "en": [
      "it's using that mistake as",
      "permission to keep going."
     ],
     "texte": "y tu café del domingo [[por fin tiene un plan]]"
    }
   },
