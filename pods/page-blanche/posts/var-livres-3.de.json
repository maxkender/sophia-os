{
 "post_id": "var-livres-3",
 "slides": {
  "1": {
   "textes": {
    "T1": {
     "en": [
      "5 things i did that fixed my",
      "phone addiction"
     ],
     "texte": "5 Bücher, die sich wie eine [[Serie]] lesen"
    },
    "T2": {
     "en": [
      "(from 14 hours",
      "screen time to 3)"
     ],
     "texte": "(du legst sie nicht mehr weg)"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_01bde28c.jpg",
      "boite": [
       0,
       0,
       1664,
       2496
      ]
     }
    }
   }
  },
  "2": {
   "textes": {
    "T1": {
     "en": [
      "make decisions before you feel ready"
     ],
     "texte": "1. [[Chronik eines angekündigten Todes]]"
    },
    "T2": {
     "en": [
      "there will never be a",
      "perfect moment, you will",
      "never feel ready"
     ],
     "texte": "García Márquez. schon ab Seite 1 weißt du, dass er stirbt"
    },
    "T3": {
     "en": [
      "take that risk you've",
      "been thinking about, you",
      "have nothing to lose"
     ],
     "texte": "das ganze Dorf wusste es, keiner hat ihn gewarnt. [[du musst wissen, warum]]"
    },
    "T4": {
     "en": [
      "procrastination is making you lose trust in yourself"
     ],
     "texte": "nur 120 Seiten, liest sich wie [[ein echter Krimi]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_0d90650e.jpg",
      "boite": [
       0,
       0,
       2368,
       1760
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "2. [[Bonjour tristesse]]"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Sagan schrieb es mit 18. ein Sommer an der Côte d'Azur"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "Cécile ist 17, ihr Leben ist perfekt, bis Anne auftaucht. dann [[schmiedet sie einen Plan]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "du hasst sie, du verstehst sie und blätterst weiter, [[ohne aufhören zu können]]"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[ein Abend]] und fertig"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_0ba43121.jpg",
      "boite": [
