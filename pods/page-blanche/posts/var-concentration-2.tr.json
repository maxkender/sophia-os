  "2": {
   "textes": {
    "T1": {
     "en": [
      "they make decisions fast"
     ],
     "texte": "[[yatakta]] çalışmak"
    },
    "T2": {
     "en": [
      "successful people don’t procrastinate. they don’t",
      "ask for permission, but instead act and ask for",
      "forgiveness"
     ],
     "texte": "laptop dizlerinde, yorgan üstünde, yastık sırtında. çok rahat ama beynin için [[yatak = dinlenme]]"
    },
    "T3": {
     "en": [
      "they don’t spend 3",
      "weeks thinking",
      "about a reversible",
      "choice"
     ],
     "texte": "yani yatağa yerleştiğin an [[odaklanman eriyip gidiyor]]"
    },
    "T4": {
     "en": [
      "if the downside is small, they decide, act, and",
      "adjust. speed matters most when decisions can",
      "be changed later"
     ],
     "texte": "tersi de geçerli: orada çalıştıkça [[daha kötü uyuyorsun]]. yatak uyumak için"
    }
   },
