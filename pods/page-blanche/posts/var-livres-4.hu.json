  "2": {
   "textes": {
    "T1": {
     "en": [
      "learn to tolerate boring repetition"
     ],
     "texte": "1. [[Fehér éjszakák]], Dosztojevszkij"
    },
    "T2": {
     "en": [
      "most success is less",
      "exciting than it looks"
     ],
     "texte": "négy éjszaka, két idegen egy pétervári hídon"
    },
    "T3": {
     "en": [
      "it’s doing the same",
      "useful things for",
      "months after the",
      "novelty disappears"
     ],
     "texte": "a lány valaki mást vár, te mégis [[minden oldalon szurkolsz a srácnak]]"
    },
    "T4": {
     "en": [
      "consistency gets powerful when other people get bored",
      "and move on"
     ],
     "texte": "nagyjából 70 oldal, [[a legrövidebb szívfájdalom, amit valaha olvasol]]"
    }
   },
   "images": {
    "I1": {
