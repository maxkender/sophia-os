  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "drži [[zavjese navučene]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "ni zrake dnevnog svjetla, samo svjetlo mobitela. mozak misli da su 3 ujutro"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "pa ostaje u modu spavanja, a ti lutaš po kuhinji kao [[potpuno izgubljeni zombi]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "svjetlo je ionako [[za jutarnje tipove]]"
    }
   },
   "images": {
