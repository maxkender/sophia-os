  "5": {
   "textes": {
    "T1": {
     "en": [
      "googling things before you try",
      "to remember"
     ],
     "fr": "googler un truc [[avant même d'essayer de t'en souvenir]]",
     "texte": "googlear las cosas [[antes de intentar recordarlas]]"
    },
    "T2": {
     "en": [
      "a name, a word, a movie you watched, you look",
      "it up the second you forget it"
     ],
     "fr": "un nom, un mot, un film que t'as vu, tu cherches [[dès que ça t'échappe]]",
     "texte": "un nombre, una palabra, una peli que viste, lo buscas [[en cuanto se te olvida]]"
    },
    "T3": {
     "en": [
      "your brain stops",
      "storing things it",
      "knows it can just",
      "find"
     ],
     "fr": "ton cerveau arrête de stocker ce qu'il [[sait pouvoir retrouver]]",
     "texte": "tu cerebro deja de guardar lo que [[sabe que puede buscar]]"
    },
    "T4": {
     "en": [
      "try to remember for 30 seconds",
