  "3": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "2. [[L'alchimista]], Coelho"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "un giovane pastore sogna un tesoro vicino alle piramidi, vende le pecore e parte, e [[la strada gli insegna più dell'oro]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "meno di 200 pagine, [[un weekend]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "cosa ha sostituito il mio scroll: un libro in borsa, musica quando cammino e [[l'app Sophia]] quando prendo comunque il telefono"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "la lezione di 5 minuti di oggi lì: perché la porpora è il colore dei re"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
