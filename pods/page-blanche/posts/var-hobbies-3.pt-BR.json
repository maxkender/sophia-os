  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "caminhe [[rápido, ao ar livre]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "40 minutos, 3 vezes por semana, num lugar verde. sem podcast: deixa a mente [[viajar e se organizar]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "em idosos, um ano de caminhada rápida [[aumentou o hipocampo]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "e as melhores ideias aparecem [[no meio do caminho]]"
    }
   },
