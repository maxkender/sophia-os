  "2": {
   "textes": {
    "T1": {
     "en": [
      "make decisions before you feel ready"
     ],
     "texte": "1. [[Χρονικό ενός προαναγγελθέντος θανάτου]]"
    },
    "T2": {
     "en": [
      "there will never be a",
      "perfect moment, you will",
      "never feel ready"
     ],
     "texte": "Γκαρσία Μάρκες. από την πρώτη σελίδα ξέρεις ότι θα πεθάνει"
    },
    "T3": {
     "en": [
      "take that risk you've",
      "been thinking about, you",
      "have nothing to lose"
     ],
     "texte": "όλο το χωριό το ήξερε, κανείς δεν τον προειδοποίησε. [[πρέπει να μάθεις γιατί]]"
    },
    "T4": {
     "en": [
      "procrastination is making you lose trust in yourself"
     ],
     "texte": "μόλις 120 σελίδες, διαβάζεται σαν [[καλό αστυνομικό]]"
    }
   },
   "images": {
    "I1": {
