  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "walk [[fast, outside]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "40 minutes, three times a week, somewhere green. no podcast needed: let your mind [[wander and sort things out]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "in older adults, a year of brisk walking [[grew the memory hub]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "and your best ideas show up [[halfway round the block]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
