  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "odloži alarm [[6 puta zaredom]]"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "na svakih 9 minuta ponovo zaspiš, a alarm te opet iščupa iz sna. baš odmarajuće"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "posle sat vremena konačno ustaneš, [[a umor je veći nego na prvom alarmu]], i imaš još 12 minuta"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "četkica za zube u jednoj ruci, patika u drugoj, i trkom kroz vrata. [[totalni mir]]"
    }
   },
   "images": {
