   "textes": {
    "T1": {
     "en": [
      "challenge your own biases"
     ],
     "texte": "[[hüzünlü playlisti]] aç"
    },
    "T2": {
     "en": [
      "your brain loves evidence that proves what you",
      "already believe"
     ],
     "texte": "sabah 7'de ayrılık şarkılarından daha iyi uyandıran ne var ki?"
    },
    "T3": {
     "en": [
      "actively look for the",
      "strongest argument",
      "against your opinion"
     ],
     "texte": "üçüncü şarkıda camdan dışarı bakıyorsun, [[2004 klibi]] gibi"
    },
    "T4": {
     "en": [
      "getting smarter",
      "means getting better",
      "at noticing when your",
      "own thinking is wrong"
     ],
     "texte": "ve işe [[kötü biten bir film enerjisiyle]] gidiyorsun. süper motive !!"
    }
