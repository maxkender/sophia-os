  "2": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "μάθε [[ένα όργανο]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "να διαβάζεις νότες, να κουνάς και τα δύο χέρια και να ακούς μαζί είναι [[γυμναστική για τον εγκέφαλο]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "στους μουσικούς, τα δύο μισά του εγκεφάλου είναι [[πιο συνδεδεμένα]]"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "δεν χρειάζεσαι ταλέντο, 15 λεπτά εξάσκηση τη μέρα φτάνουν για να [[γυμνάσεις τον εγκέφαλό σου]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_51db9d8e.jpg",
      "boite": [
       0,
       0,
       832,
       1248
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "stop announcing your plans"
     ],
     "texte": "μάθε [[μια χορογραφία]]"
    },
    "T2": {
     "en": [
      "telling everyone your goals can give you a hit of",
      "dopamine before you've actually done anything"
     ],
     "texte": "θυμάσαι μια σειρά από βήματα, κρατάς τον ρυθμό και διορθώνεσαι [[την ώρα που κινείσαι]]"
    },
    "T3": {
     "en": [
      "you get to feel",
      "ambitious, receive",
      "praise, and imagine",
      "the end result",
      "without putting in",
      "the work"
     ],
     "texte": "μια μελέτη 21 χρόνων συνέδεσε τον τακτικό χορό με [[μικρότερο κίνδυνο άνοιας]]"
    },
    "T4": {
     "en": [
      "stop talking about what you're going to do. disappear,",
      "put your head down, and let your results speak for you"
     ],
     "texte": "μνήμη, συντονισμός και συγκέντρωση μαζί, και σοβαρά [[ο πιο διασκεδαστικός τρόπος]] να τα γυμνάσεις"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_f36edfe3.jpg",
      "boite": [
       0,
       0,
       2208,
       1888
      ]
     }
    }
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "βρες τον δρόμο σου [[χωρίς GPS]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "ακολούθησε τον χάρτη στο μυαλό σου και πρόσεξε δρόμους, μαγαζιά, [[στροφές]]"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "οι ταξιτζήδες του Λονδίνου έχουν [[μεγαλύτερη περιοχή μνήμης]] στον εγκέφαλο"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "παλιά σκρόλαρα ασταμάτητα, τώρα στο κινητό κάνω [[μάθημα 5 λεπτών στην εφαρμογή Sophia]]"
    }
   },
