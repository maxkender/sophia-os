    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "they get comfortable looking",
      "stupid"
     ],
     "texte": "valandų valandas mokytis [[prie uždaryto lango]]"
    },
    "T2": {
     "en": [
      "they ask basic questions, try things before they feel",
      "ready, and admit when they don’t know"
     ],
     "texte": "durys ir langas uždaryti, oras sunkėja, o galva tarsi vatoje, ir net nežinai kodėl"
    },
    "T3": {
     "en": [
      "protecting your",
      "ego feels safe,",
      "but it slows",
      "learning down",
      "massively"
     ],
     "texte": "harvardo tyrimas parodė: tvankus oras = [[lėtesnės smegenys]]"
    },
    "T4": {
     "en": [
      "growth feels uncomfortable, but",
      "nothing changes if nothing changes"
     ],
     "texte": "atidaryk langą [[10 min kas valandą]], ir galva prasivalys"
    }
   },
