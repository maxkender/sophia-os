  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "fr": "lis des livres [[au lieu de scroller]]",
     "texte": "olvass könyvet [[görgetés helyett]]"
    },
    "T2": {
     "en": [
      "bill gates reads around 50 books a year"
     ],
     "fr": "bill gates lit environ [[50 livres par an]]",
     "texte": "bill gates nagyjából [[évi 50 könyvet]] olvas"
    },
    "T3": {
     "en": [
      "doomscrolling is rotting your",
      "brain"
     ],
     "fr": "le doomscroll [[te grille le cerveau]]",
     "texte": "a doomscrolling [[szétrohasztja az agyad]]"
    },
    "T4": {
     "en": [
      "books do the opposite, they",
      "make you focus and think for",
      "yourself"
     ],
     "fr": "les livres font l'inverse, tu [[te concentres]] et tu [[penses par toi-même]]",
     "texte": "a könyv épp fordítva működik: [[fókuszálsz]] és [[magadtól gondolkodsz]]"
    },
    "T5": {
     "en": [
      "i used to doomscroll all day",
      "but now use this thing that",
      "blocks my apps until i read",
      "for 20 minutes"
     ],
     "fr": "tant qu'à être sur mon tel, je fais 5 min sur [[l'appli Sophia]]. aujourd'hui : [[pourquoi camus imaginait sisyphe heureux]]",
     "texte": "ha már úgyis telózom, 5 percet tanulok [[a Sophia appban]]. a mai: [[miért Olaszországban kezdődött a reneszánsz]]"
    }
   },
