  "4": {
   "textes": {
    "T1": {
     "en": [
      "study longer than you want to"
     ],
     "texte": "escreva [[à mão]]"
    },
    "T2": {
     "en": [
      "the useful part usually starts when your brain",
      "wants to quit"
     ],
     "texte": "um diário, uma carta, suas anotações: [[caneta, não teclado]]"
    },
    "T3": {
     "en": [
      "stay for another",
      "20–30 minutes",
      "after you feel",
      "bored, distracted,",
      "or restless"
     ],
     "texte": "um estudo de 2024: o cérebro fica [[muito mais conectado]] escrevendo à mão do que digitando"
    },
    "T4": {
     "en": [
      "you're not just learning the subject, you're training",
      "yourself to keep going when motivation disappears"
     ],
     "texte": "é mais lento, e essa é a graça: você precisa [[escolher as palavras]] antes de colocar no papel"
    }
   },
