  "2": {
   "textes": {
    "T1": {
     "en": [
      "say no to almost everything"
     ],
     "texte": "keep [[3 topics]] in your pocket"
    },
    "T2": {
     "en": [
      "warren buffett said really successful people say",
      "no to almost everything"
     ],
     "texte": "one thing you watched, one you read, [[one that happened to you]]"
    },
    "T3": {
     "en": [
      "stop being a people's",
      "pleaser"
     ],
     "texte": "pick them [[before you go out]]"
    },
    "T4": {
     "en": [
      "you'll have less time for",
      "what actually matters"
     ],
     "texte": "when it goes quiet, [[you just pull one out]]"
    },
    "T5": {
     "en": [
      "protect your time like",
      "it's the most valuable",
      "thing you have"
     ],
     "texte": "no more [[blank mind]] the second someone looks at you"
    }
   },
