  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "faça algo [[com as mãos]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "cerâmica, tricô, madeira: suas mãos testam, seus olhos conferem e [[seu cérebro planeja cada gesto]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "um estudo liga trabalhos manuais a [[menos problemas de memória]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "e no fim você tem uma coisa real, não [[mais um vídeo salvo]]"
    }
   },
