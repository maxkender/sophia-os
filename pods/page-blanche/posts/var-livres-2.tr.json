  "2": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "1. [[Yaşlı Adam ve Deniz]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "yaşlı bir balıkçı, 84 gün tek balık yok, sonra [[dev bir balık]] ve asla pes etmiyor"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "denizde upuzun bir mücadele, ve son sayfaya kadar [[onun için tutuyorsun]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "Hemingway, 120 sayfa, [[tembel bir pazar]]"
    }
   },
   "images": {
