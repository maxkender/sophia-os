  "6": {
   "textes": {
    "T1": {
     "en": [
      "wake up before everyone else"
     ],
     "fr": "lève-toi [[avant tout le monde]]",
     "texte": "kelj fel [[mindenki más előtt]]"
    },
    "T2": {
     "en": [
      "no messages, no notifications, no one needs you yet"
     ],
     "fr": "zéro message, zéro notif, [[personne n'a besoin de toi]]",
     "texte": "nincs üzenet, nincs értesítés, [[még senkinek nem kellesz]]"
    },
    "T3": {
     "en": [
      "the first hour of the day is",
      "when your focus is at its",
      "best, so use it for your",
      "own goals"
     ],
     "fr": "dans la première heure de la journée, ta concentration est [[au max]], garde-la pour tes objectifs",
     "texte": "a nap első órájában [[a legjobb a fókuszod]], úgyhogy a saját céljaidra használd"
    },
    "T4": {
     "en": [
      "before anyone else can",
      "take your attention"
     ],
     "fr": "avant que quelqu'un [[te prenne ton attention]]",
     "texte": "mielőtt bárki más [[elvenné a figyelmed]]"
    },
    "T5": {
     "en": [
      "even 30 minutes earlier makes a difference"
     ],
     "fr": "même [[30 minutes plus tôt]], ça change tout",
     "texte": "már [[30 perccel korábban]] is sokat számít"
    }
   },
