  "5": {
   "textes": {
    "T1": {
     "en": [
      "train a martial art"
     ],
     "texte": "φτιάξε κάτι [[με τα χέρια σου]]"
    },
    "T2": {
     "en": [
      "you get corrected constantly, exposed when your",
      "technique is bad, and forced to keep going when",
      "you're tired"
     ],
     "texte": "κεραμική, πλέξιμο, ξύλο: τα χέρια δοκιμάζουν, τα μάτια ελέγχουν και [[ο εγκέφαλος σχεδιάζει κάθε κίνηση]]"
    },
    "T3": {
     "en": [
      "martial arts teaches",
      "you to stay calm under",
      "pressure"
     ],
     "texte": "μια μελέτη συνδέει τις χειροτεχνίες με [[λιγότερα προβλήματα μνήμης]]"
    },
    "T4": {
     "en": [
      "instead of quitting the",
      "second something gets",
      "uncomfortable"
     ],
     "texte": "και στο τέλος έχεις κάτι αληθινό, όχι [[ένα ακόμα αποθηκευμένο βίντεο]]"
    }
   },
