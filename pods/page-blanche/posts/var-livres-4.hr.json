  "3": {
   "textes": {
    "T1": {
     "en": [
      "scrolling whenever you're bored"
     ],
     "texte": "2. [[Alkemičar]], Paulo Coelho, 1988"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "mladi pastir sanja o skrivenom blagu kod piramida, prodaje ovce i kreće na put, a [[put ga nauči više od zlata]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "do 200 stranica, [[jedan vikend]]"
    },
    "T4": {
     "en": [
      "i personally use readup to",
      "block tiktok until i read for",
      "20 minutes, which keeps",
      "me from mindlessly scrolling"
     ],
     "texte": "što je zamijenilo moje skrolanje: knjiga u torbi, glazba u šetnji i [[aplikacija Sophia]] kad ipak uzmem mobitel"
    },
    "T5": {
     "en": [
      "your phone can wait until",
      "you have done one thing",
      "you meant to do."
     ],
     "texte": "današnjih 5 minuta tamo: zašto je renesansa nastala u Italiji"
    }
   },
   "images": {
    "I1": "sophia_capture"
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[Biser]], Steinbeck"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "siromašni ronilac nađe najveći biser koji je itko ikad vidio"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "liječnik, trgovci, cijeli grad ga žele, a njegov san [[polako postaje noćna mora]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "manje od 100 stranica, pisano kao stara basna, gotovo za jednu večer"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[a tek kakav je kraj!]]"
    }
   },
