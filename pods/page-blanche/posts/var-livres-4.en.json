  "4": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "3. [[The Pearl]] (1947)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "Steinbeck. a poor diver finds the biggest pearl anyone has seen"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "the doctor, the dealers, the whole town want it, and his dream [[slowly turns into a nightmare]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "under 100 pages, written like an old fable, finished in one evening"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[that ending, though]]"
    }
