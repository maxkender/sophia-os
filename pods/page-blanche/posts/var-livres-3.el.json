  "3": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "texte": "2. [[Καλημέρα θλίψη]] (1954)"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "texte": "η Σαγκάν το έγραψε στα 18 της. ένα καλοκαίρι στη Γαλλική Ριβιέρα"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "texte": "η Σεσίλ είναι 17, η ζωή της τέλεια, ώσπου έρχεται η Αν. και τότε [[στήνει ένα σχέδιο]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "texte": "τη μισείς, την καταλαβαίνεις και γυρνάς σελίδες [[χωρίς να μπορείς να σταματήσεις]]"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "texte": "[[ένα βράδυ]] και τελείωσε"
    }
   },
   "images": {
