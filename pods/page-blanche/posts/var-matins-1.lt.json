  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "laikyk [[užtrauktas užuolaidas]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "nė spindulio dienos šviesos, tik telefono švytėjimas. smegenys galvoja, kad dabar 3 nakties"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "tad jos lieka miego režime, o tu klaidžioji po virtuvę kaip [[pasimetęs zombis]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "šviesa vis tiek [[skirta rytiniams žmonėms]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
