  "2": {
   "textes": {
    "T1": {
     "en": [
      "spend more time without stimulation"
     ],
     "texte": "hit snooze [[six times]], every morning"
    },
    "T2": {
     "en": [
      "stop filling every walk,",
      "meal, and spare minute",
      "with content and music"
     ],
     "texte": "every 9 minutes you drift back off, then get yanked out of it again. so restful"
    },
    "T3": {
     "en": [
      "quiet gives your brain",
      "room to replay",
      "information, connect",
      "ideas, and form its own",
      "thoughts"
     ],
     "texte": "after an hour of that you finally get up, [[more tired than at the first alarm]], with 12 minutes left"
    },
    "T4": {
     "en": [
      "constant short-form content is making your brain rot",
      "and ruining your attention span!!"
     ],
     "texte": "toothbrush in one hand, shoe in the other, sprinting out the door. [[peak serenity]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_6b621671.jpg",
