     ],
     "texte": "3. [[La Ferme des animaux]], Orwell"
    },
    "T2": {
     "en": [
      "you can lose 2–3 hours a day without even noticing,",
      "then wonder why you have no time for the things you",
      "care about"
     ],
     "texte": "les animaux chassent le fermier pour être libres et égaux, puis les cochons prennent le pouvoir et [[les règles changent la nuit]]"
    },
    "T3": {
     "en": [
      "be deliberate with your",
      "time."
     ],
     "texte": "à peine 100 pages, [[une nuit]]"
    },
