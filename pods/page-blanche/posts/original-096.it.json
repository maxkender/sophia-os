  "3": {
   "textes": {
    "T1": {
     "en": [
      "face your fears instead of running"
     ],
     "fr": "affronta la paura [[invece di scappare]]",
     "texte": "punta a 5 minuti, [[non a un'ora]]"
    },
    "T2": {
     "en": [
      "every time you avoid it, the fear gets bigger"
     ],
     "fr": "ogni volta che la eviti, la paura [[cresce]]",
     "texte": "un'ora suona benissimo, finché [[non la salti]]"
    },
    "T3": {
     "en": [
      "the conversation",
      "you keep putting",
      "off, the class you're",
      "scared to speak in,"
     ],
     "fr": "il discorso che rimandi, la lezione in cui temi di parlare,",
     "texte": "5 minuti sono così pochi che il cervello non trova una scusa per saltarli,"
    },
    "T4": {
     "en": [
      "the thing you think",
      "you'll fail at"
     ],
     "fr": "la cosa in cui pensi di [[fallire]]",
     "texte": "nemmeno nei giorni [[più pesanti]]"
    },
    "T5": {
     "en": [
      "the more you do things scared, the faster you learn",
      "and the easier hard things get"
     ],
     "fr": "più fai le cose con la paura, [[più impari veloce]] e [[più il difficile diventa facile]]",
     "texte": "una piccola abitudine che mantieni batte un grande piano che molli, e [[a volte 5 minuti diventano 20]]"
    }
   },
