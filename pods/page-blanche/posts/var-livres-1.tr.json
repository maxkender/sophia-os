  "1": {
   "textes": {
    "T1": {
     "en": [
      "7 ways to stop doomscrolling",
      "and reclaim your life"
     ],
     "fr": "7 trucs pour arrêter de scroller et reprendre ta vie",
     "texte": "okumaktan [[nefret ettiğini]] sananlar için 5 kitap"
    },
    "T2": {
     "en": [
      "from an",
      "ex-chronic",
      "scroller"
     ],
     "fr": "par une ex-accro au scroll",
     "texte": "(kısa ve elden bırakılmıyor)"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/7700620281760533792_1.jpg",
      "boite": [
       95,
       420,
       590,
       437
      ]
     }
    }
   }
  },
  "2": {
   "textes": {
    "T1": {
     "en": [
      "learn to tolerate boring repetition"
     ],
     "fr": "apprends à [[supporter la routine chiante]]",
     "texte": "1. [[Fareler ve İnsanlar]], Steinbeck"
    },
    "T2": {
     "en": [
      "most success is less",
      "exciting than it looks"
     ],
     "fr": "réussir, c'est [[moins excitant]] que ça en a l'air",
     "texte": "iki işçi, tek hayal: [[kendi çiftlikleri]]"
    },
    "T3": {
     "en": [
      "it’s doing the same",
      "useful things for",
      "months after the",
      "novelty disappears"
     ],
     "fr": "c'est répéter les mêmes trucs utiles [[des mois]], bien après l'effet waouh",
     "texte": "kötü bir şey olacağını hissediyorsun ama yine de [[bırakamıyorsun]]"
    },
    "T4": {
     "en": [
      "consistency gets powerful when other people get bored",
      "and move on"
     ],
     "fr": "[[la régularité]] devient une force quand les autres s'ennuient et lâchent",
     "texte": "yaklaşık 100 sayfa ve sonu [[günlerce aklından hiç çıkmayacak]]"
    }
   },
   "images": {
    "I1": "garder"
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "let yourself be bored"
     ],
     "fr": "accepte de t'[[ennuyer]]",
     "texte": "2. [[Satranç]], Stefan Zweig"
    },
    "T2": {
     "en": [
      "every queue, walk and",
      "bathroom break gets filled",
      "with input now"
     ],
     "fr": "[[chaque]] file d'attente, balade, pause pipi : on remplit tout",
     "texte": "bir gemide, dünya satranç şampiyonu sessiz bir yabancıyla karşılaşıyor"
    },
    "T3": {
     "en": [
      "that sounds harmless, but",
      "you're removing every",
      "chance your attention has",
      "to sit still"
     ],
     "fr": "ça a l'air de rien, mais ton attention n'a [[plus jamais l'occasion]] de se poser",
     "texte": "satrançtan hiç anlaman gerekmiyor, asıl konu [[bir zihnin ne kadar zorlanabileceği]]"
    },
    "T4": {
     "en": [
      "spend 20–30 minutes a day with no podcast,",
      "music, scrolling or second screen"
     ],
     "fr": "chaque jour, [[20-30 minutes]] sans podcast, musique, scroll ni deuxième écran",
     "texte": "100 sayfadan kısa, bir akşam ya da uzun bir tren yolculuğu için ideal"
    },
    "T5": {
     "en": [
      "listen to your thoughts"
     ],
     "fr": "[[écoute tes pensées]]",
     "texte": "[[elinden bırakamayacaksın]]"
    }
   },
   "images": {
    "I1": "garder"
   }
  },
  "4": {
   "textes": {
    "T1": {
     "en": [
      "make decisions before you feel ready"
     ],
     "fr": "décide [[avant de te sentir prête]]",
     "texte": "3. Franz Kafka'nın [[Dönüşüm]] kitabı"
    },
    "T2": {
     "en": [
      "there will never be a",
      "perfect moment, you will",
      "never feel ready"
     ],
     "fr": "[[le moment parfait n'existe pas]], tu te sentiras jamais prête",
     "texte": "bir sabah dev bir böceğe dönüşüyor ve ilk derdi [[işe geç kalmak]]"
    },
    "T3": {
     "en": [
      "take that risk you've",
      "been thinking about, you",
      "have nothing to lose"
     ],
     "fr": "prends ce risque auquel tu penses depuis longtemps, [[t'as rien à perdre]]",
     "texte": "kulağa saçma geliyor ama hayatın tıkandıysa [[tuhaf şekilde tanıdık]]"
    },
    "T4": {
     "en": [
      "procrastination is making you lose trust in yourself"
     ],
     "fr": "procrastiner te fait [[perdre confiance en toi]]",
     "texte": "100 sayfadan kısa, [[tek oturuşta rahatça bitiyor]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/7685340052989398275_1.jpg",
      "boite": [
       97,
