   }
  },
  "5": {
   "textes": {
    "T1": {
     "en": [
      "get good at writing"
     ],
     "texte": "4. [[El principito]]"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "Saint-Exupéry, menos de 100 páginas"
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "un piloto perdido en el desierto conoce a un niño de un planeta diminuto, que [[hace las mejores preguntas]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
      "marketing, leadership, sales, and building an",
      "audience"
     ],
     "texte": "crees que es un libro para niños, hasta que una frase te golpea y entiendes que [[nunca fue para niños]]"
    }
