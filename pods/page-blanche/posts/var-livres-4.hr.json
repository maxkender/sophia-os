    "T1": {
     "en": [
      "learn to tolerate boring repetition"
     ],
     "texte": "1. [[Bijele noći]], F. M. Dostojevski"
    },
    "T2": {
     "en": [
      "most success is less",
      "exciting than it looks"
     ],
     "texte": "četiri noći, dvoje stranaca na jednom mostu"
    },
    "T3": {
     "en": [
      "it’s doing the same",
      "useful things for",
      "months after the",
      "novelty disappears"
     ],
     "texte": "ona čeka nekog drugog, a ti se i dalje [[nadaš za njega na svakoj stranici]]"
    },
    "T4": {
     "en": [
      "consistency gets powerful when other people get bored",
      "and move on"
     ],
     "texte": "oko 70 stranica, [[najkraće slomljeno srce koje ćeš pročitati]]"
    }
   },
