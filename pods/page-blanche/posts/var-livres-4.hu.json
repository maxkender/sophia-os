  "6": {
   "textes": {
    "T1": {
     "en": [
      "get good at writing"
     ],
     "texte": "5. [[Sziddhárta]]"
    },
    "T2": {
     "en": [
      "clear writing forces clear",
      "thinking"
     ],
     "texte": "Hermann Hesse, nagyjából 150 oldal"
    },
    "T3": {
     "en": [
      "learn how to explain",
      "complicated ideas",
      "simply, write convincing",
      "messages, and make",
      "people actually care"
     ],
     "texte": "egy fiatal férfi az élet értelmét keresi, kipróbálja a gazdagságot és a szerelmet, és [[egy folyó partján talál rá]]"
    },
    "T4": {
     "en": [
      "if you can write well, you'll be better at",
      "marketing, leadership, sales, and building an",
      "audience"
     ],
     "texte": "egyszerű mondatok, rövid fejezetek és egy nyugalom, ami napokig megmarad. [[a tökéletes hétvégezáró könyv]]"
    }
