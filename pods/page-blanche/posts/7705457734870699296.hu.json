  "3": {
   "textes": {
    "T1": {
     "en": [
      "understand it's all your fault"
     ],
     "fr": "accepte que [[tout est de ta faute]]",
     "texte": "értsd meg: [[minden a te hibád]]"
    },
    "T2": {
     "en": [
      "your job, your body, your grades, your habits, your",
      "position it's all your fault"
     ],
     "fr": "ton taf, ton corps, tes notes, tes habitudes, ta place, [[c'est ta faute]]",
     "texte": "a munkád, a tested, a jegyeid, a szokásaid, a helyzeted, [[mind a te hibád]]"
    },
    "T3": {
     "en": [
      "that sounds harsh, but",
      "it's actually good news"
     ],
     "fr": "dur à entendre, mais c'est une bonne nouvelle",
     "texte": "tudom, durván hangzik, de igazából jó hír"
    },
    "T4": {
     "en": [
      "if it's your fault, it's also",
      "in your control, you don't",
      "have to be the person",
      "you were yesterday, you",
      "can change"
     ],
     "fr": "si c'est ta faute, c'est aussi [[entre tes mains]], rien ne t'oblige à rester la personne d'hier, tu peux changer",
     "texte": "ha a te hibád, akkor [[a te kezedben is van]], nem kell annak maradnod, aki tegnap voltál, tudsz változni"
    }
   },
