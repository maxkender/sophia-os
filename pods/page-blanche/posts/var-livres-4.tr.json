  "5": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "4. [[Bir Noel Şarkısı]] (1843)"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "Dickens. açgözlü yaşlı bir adamı tek bir gecede üç hayalet ziyaret eder"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "geçmiş, şimdi ve gelecek, ve sabah olduğunda [[artık aynı adam değildir]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "100 sayfa civarı, [[aralık için birebir]]"
    }
   },
