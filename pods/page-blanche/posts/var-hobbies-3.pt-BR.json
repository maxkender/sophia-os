  "2": {
   "textes": {
    "T1": {
     "en": [
      "stop announcing your plans"
     ],
     "texte": "aprenda [[fotografia]]"
    },
    "T2": {
     "en": [
      "telling everyone your goals can give you a hit of",
      "dopamine before you've actually done anything"
     ],
     "texte": "luz, enquadramento, o momento certo: cada foto te ensina a [[ver o que todo mundo ignora]]"
    },
    "T3": {
     "en": [
      "you get to feel",
      "ambitious, receive",
      "praise, and imagine",
      "the end result",
      "without putting in",
      "the work"
     ],
     "texte": "num estudo, idosos que aprenderam fotografia por 3 meses [[melhoraram mais a memória]] do que quem só socializava"
    },
    "T4": {
     "en": [
      "stop talking about what you're going to do. disappear,",
      "put your head down, and let your results speak for you"
     ],
     "texte": "não precisa de equipamento caro, o celular já basta pra começar, o lance é [[aprender a olhar]]"
    }
   },
   "images": {
    "I1": {
     "remplacer": {
      "source": "sources/os_0a28ab50.jpg",
      "boite": [
       0,
       0,
       2368,
       1760
      ]
     }
    }
   }
  },
  "3": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "aprenda [[outro idioma]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "palavras novas, outra gramática: seu cérebro [[alterna entre dois sistemas]] o dia todo"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "em pessoas bilíngues, os sintomas de demência aparecem [[uns 4 anos depois]], em média"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "hoje finalmente entendi por que o Renascimento começou na Itália, em 5 min no [[app Sophia]]"
    }
   },
