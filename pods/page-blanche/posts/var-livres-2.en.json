    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "1. [[The Old Man and the Sea]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "an old fisherman, 84 days with no catch, then [[one giant fish]] that won't give up"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "it's one long fight at sea, and you [[root for him]] until the very last page"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "Hemingway, 120 pages, [[one lazy sunday]]"
    }
   },
   "images": {
