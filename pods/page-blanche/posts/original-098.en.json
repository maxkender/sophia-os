  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "share [[one thing you learned]] this week"
    },
    "T2": {
     "en": [
      "bill gates reads around 50 books a year"
     ],
     "texte": "a random story works [[better than the weather]]"
    },
    "T3": {
     "en": [
      "doomscrolling is rotting your",
      "brain"
     ],
     "texte": "you can only share [[what you took in]]"
    },
    "T4": {
     "en": [
      "books do the opposite, they",
      "make you focus and think for",
      "yourself"
     ],
     "texte": "this week mine was [[why the renaissance started in italy]]"
    },
    "T5": {
     "en": [
      "i used to doomscroll all day",
      "but now use this thing that",
      "blocks my apps until i read",
      "for 20 minutes"
     ],
     "texte": "what replaced my scrolling: a book, podcasts on walks, and [[the Sophia app]] when i grab my phone anyway"
    }
   },
