  "4": {
   "textes": {
    "T1": {
     "en": [
      "read books instead of scrolling"
     ],
     "texte": "orientier dich [[ohne GPS]]"
    },
    "T2": {
     "en": [
      "a book makes you follow one idea for pages.",
      "scrolling trains that out of your head"
     ],
     "texte": "folg der Karte in deinem Kopf und merk dir Straßen, Läden, [[Abzweigungen]]"
    },
    "T3": {
     "en": [
      "if you want to think",
      "deeper, give your brain",
      "something long before",
      "anything short"
     ],
     "texte": "Londoner Taxifahrer haben [[einen größeren Gedächtnisbereich]] im Gehirn"
    },
    "T4": {
     "en": [
      "i use readup which blocks",
      "my apps until i read for 20",
      "minutes, which stopps me",
      "from scrolling"
     ],
     "texte": "früher hab ich ständig gescrollt, heute lern ich am Handy in 5 Min was Neues mit [[der Sophia-App]]"
    }
   },
