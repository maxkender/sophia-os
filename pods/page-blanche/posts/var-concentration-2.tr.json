  "3": {
   "textes": {
    "T1": {
     "en": [
      "they get comfortable looking",
      "stupid"
     ],
     "texte": "saatlerce [[pencere kapalı]] ders çalışmak"
    },
    "T2": {
     "en": [
      "they ask basic questions, try things before they feel",
      "ready, and admit when they don’t know"
     ],
     "texte": "kapı ve pencere kapalı, hava ağırlaşıyor ve nedenini bilmeden kafan pamuk gibi oluyor"
    },
    "T3": {
     "en": [
      "protecting your",
      "ego feels safe,",
      "but it slows",
      "learning down",
      "massively"
     ],
     "texte": "harvard'dan bir çalışma gösterdi: havasız oda = [[yavaşlayan beyin]]"
    },
    "T4": {
     "en": [
      "growth feels uncomfortable, but",
      "nothing changes if nothing changes"
     ],
     "texte": "her saat [[10 dakika pencereyi aç]], kafan açılsın"
