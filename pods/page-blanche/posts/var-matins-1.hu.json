  "3": {
   "textes": {
    "T1": {
     "en": [
      "2. stop trying to multitask"
     ],
     "texte": "tartsd [[behúzva a függönyt]]"
    },
    "T2": {
     "en": [
      "every task switch forces",
      "your working memory to",
      "drop one context and",
      "load another"
     ],
     "texte": "semmi napfény, csak a telefonod fénye. az agyad azt hiszi, hajnali 3 óra van"
    },
    "T3": {
     "en": [
      "doing 2 things at once",
      "feels productive, but",
      "your brain is just",
      "constantly re-orienting"
     ],
     "texte": "így alvó módban marad, te meg úgy bolyongsz a konyhában, mint [[egy zavarodott zombi]]"
    },
    "T4": {
     "en": [
      "one task, one tab, until it's finished"
     ],
     "texte": "a fény amúgy is [[a reggeli embereknek való]]"
    }
   },
